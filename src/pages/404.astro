---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found" noindex={true}>
  <section class="section">
    <div class="wrap center">
      <p class="eyebrow">404</p>
      <h1>This offer wandered off.</h1>
      <p class="lead">The page you’re after doesn’t exist or expired. Try the full directory.</p>
      <div class="cta">
        <a href="/offers" class="btn btn-primary">Browse all offers</a>
        <a href="/" class="btn btn-ghost">Back home</a>
      </div>
    </div>
  </section>
</Layout>
<style>
  .center { text-align: center; max-width: 44ch; margin-inline: auto; padding-block: 3rem; }
  .cta { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; margin-top: 1.5rem; }
</style>
