---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import OfferCard from '../../components/OfferCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import Icon from '../../components/Icon.astro';
import { categories, getCategory } from '../../data/categories';
import { sortOffers, isExpired } from '../../lib/offers';

export async function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const offers = sortOffers(
  (await getCollection('offers')).filter((o) => o.data.category === category.slug && !isExpired(o)),
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${category.name} student offers`,
  description: category.description,
};
---

<Layout title={`${category.name} student offers`} description={category.description} jsonLd={jsonLd}>
  <section class="section">
    <div class="wrap">
      <nav class="crumbs muted"><a href="/categories">Categories</a> › {category.name}</nav>
      <header class="cat-head" style={`--cat:${category.accent}`}>
        <span class="icon"><Icon category={category.slug} /></span>
        <div>
          <h1>{category.name}</h1>
          <p class="lead">{category.description}</p>
        </div>
      </header>

      {offers.length > 0 ? (
        <>
          <p class="muted count">{offers.length} verified offer{offers.length === 1 ? '' : 's'}</p>
          <div class="grid grid-offers">
            {offers.map((o) => <OfferCard offer={o} />)}
          </div>
        </>
      ) : (
        <p class="empty muted">No live offers here yet. We add new ones weekly.</p>
      )}

      <div style="margin-top:2.5rem"><AdSlot format="leaderboard" /></div>
    </div>
  </section>
</Layout>

<style>
  .crumbs { font-size: var(--step--1); margin-bottom: 1rem; }
  .crumbs a:hover { color: var(--accent-ink); }
  .cat-head { display: flex; gap: 1.1rem; align-items: center; margin-bottom: 1.75rem; }
  .cat-head .icon {
    display: inline-grid; place-items: center; width: 66px; height: 66px; flex: none;
    border-radius: 16px; border: 1px solid var(--border);
    background: color-mix(in srgb, var(--cat) 16%, var(--surface));
    color: color-mix(in srgb, var(--cat) 72%, var(--ink));
  }
  .cat-head .icon :global(.cat-ico) { width: 30px; height: 30px; }
  .cat-head .lead { margin-top: 0.3rem; }
  .count { margin-bottom: 1.25rem; }
  .empty { font-size: var(--step-1); margin-top: 1.5rem; }
</style>
