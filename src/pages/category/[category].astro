---
// Dedicated category landing pages were thin duplicates of the interactive
// /offers directory (same offers, no facets, generic one-line intro). They were
// collapsed into /offers filters; category links now refine /offers in place.
//
// This route only survives to 301 the old /category/<slug> URLs onto the matching
// filter, so shared links and any accrued link equity are preserved. Astro's
// static `redirects` config can't map a path param into a query string
// (InvalidRedirectDestination), so this is a tiny on-demand redirect instead.
//
// Curated category landings can return later, once a category earns unique
// editorial content (the Collections rule) — at which point this becomes a real
// page again rather than a redirect.
export const prerender = false;
import { categories } from '@domain/offers/categories';

const { category } = Astro.params;
return Astro.redirect(
  categories.some((c) => c.slug === category) ? `/offers?cat=${category}` : '/offers',
  301,
);
---
