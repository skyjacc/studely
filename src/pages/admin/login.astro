---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import Wordmark from '../../components/Wordmark.astro';
import AuthField from '../../components/AuthField.astro';
import { actions } from 'astro:actions';

const url = Astro.url;
const denied = url.searchParams.get('denied') === '1';
const nextPath = url.searchParams.get('next') ?? '/admin';

// Why the callback sent them back — three different problems, three different fixes.
const REASONS: Record<string, string> = {
  otp_expired: 'That link has expired or was already used. Request a new one.',
  access_denied: 'That link is no longer valid. Request a new one.',
  exchange_failed: 'Could not complete sign-in. Open the link in the same browser you requested it from.',
  missing_code: 'That link was incomplete. Request a new one.',
};
const reasonKey = url.searchParams.get('reason') ?? '';
const reason = REASONS[reasonKey] ?? (reasonKey ? 'That sign-in link did not work. Request a new one.' : '');

// The sign-in is now the auth.requestLink action. This form posts to it and the
// page re-renders with the result — works with JS off, and never puts a token in JS.
const result = Astro.getActionResult(actions.auth.requestLink);
const sent = result?.data?.ok === true;
const sentTo = sent && result?.data && 'email' in result.data ? result.data.email : '';
const actionError =
  result?.data && result.data.ok === false ? result.data.error
  : result?.error ? 'Could not send the link. Try again in a moment.'
  : '';
---

<AdminLayout title="Sign in" chrome={false}>
  <AuthField />

  <div class="card">
    <div class="head">
      <Wordmark class="mark" />
      <span class="eyebrow">Admin</span>
    </div>
    <h1 class="sr-only">Sign in to Studely admin</h1>

    {sent ? (
      <>
        <svg class="mailicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2.5" />
          <path d="m3.5 7.5 8.5 5.5 8.5-5.5" />
        </svg>
        <h2>Check your email</h2>
        <p class="note">
          A one-time sign-in link is on its way to <strong>{sentTo}</strong>. It expires in about an
          hour, and opening it brings you straight back to the admin.
        </p>
        <div class="foot-links">
          <form method="POST" action={actions.auth.requestLink} class="resend">
            <input type="hidden" name="email" value={sentTo} />
            <input type="hidden" name="next" value={nextPath} />
            <button class="linkbtn" type="submit">Resend link</button>
          </form>
          <a class="relink" href={`/admin/login?next=${encodeURIComponent(nextPath)}`}>Use a different email</a>
        </div>
      </>
    ) : (
      <>
        {denied && <p class="alert" role="alert">That account exists but has no admin access.</p>}
        {reason && <p class="alert" role="alert">{reason}</p>}
        {actionError && <p class="alert" role="alert">{actionError}</p>}

        <form method="POST" action={actions.auth.requestLink} class="form" id="loginform">
          <input type="hidden" name="next" value={nextPath} />
          <label class="lbl" for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="input" />
          <button class="btn btn-primary" type="submit">Email me a link</button>
        </form>
      </>
    )}

    <a class="back" href="/">← Back to site</a>
  </div>
</AdminLayout>

<script>
  // Show the submit button as busy while the request is in flight. Enhancement
  // only — the form posts to the action with or without this.
  for (const form of document.querySelectorAll<HTMLFormElement>('form.form, form.resend')) {
    form.addEventListener('submit', () => {
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btn) { btn.setAttribute('aria-busy', 'true'); btn.disabled = true; }
    });
  }
</script>

<style>
  .card {
    position: relative; z-index: 1;
    width: min(100%, 360px);
    border: 1px solid var(--border-strong); border-radius: 16px;
    background: rgba(18, 17, 16, 0.72);
    backdrop-filter: blur(14px);
    box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.9);
    padding: clamp(1.5rem, 1rem + 1.5vw, 2rem);
    transition: opacity 0.14s var(--ease-out);
  }
  /* NOT an offer card — kill the global .card:hover lift so it doesn't jump */
  .card:hover { transform: none; box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.9); border-color: var(--border-strong); }

  .head { display: flex; align-items: baseline; gap: 10px; }
  .card :global(.mark) { height: 20px; color: var(--ink); }
  .eyebrow {
    font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--text-muted);
    border: 1px solid var(--border-strong); border-radius: 6px; padding: 2px 6px;
  }

  .mailicon { width: 34px; height: 34px; color: var(--ink); margin-top: 1.3rem; }
  h2 { margin-top: 0.9rem; font-size: 1.3rem; letter-spacing: -0.02em; }
  .note { margin-top: 0.6rem; color: var(--text-muted); font-size: var(--step--1); line-height: 1.55; }
  .note strong { color: var(--ink); font-weight: 500; }
  .alert {
    margin-top: 0.9rem; padding: 0.6rem 0.75rem; border-radius: 9px;
    border: 1px solid var(--border-strong); background: var(--surface-2);
    color: var(--ink); font-size: var(--step--1);
  }

  .form { display: grid; gap: 0.5rem; margin-top: 1.4rem; }
  .lbl { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }
  .input {
    width: 100%; font: inherit; color: var(--ink);
    padding: 0.6em 0.75em; border-radius: 10px;
    border: 1px solid var(--border-control); background: var(--bg);
  }
  .input:focus { outline: 2px solid var(--ink); outline-offset: 1px; border-color: var(--ink); }
  .form button { margin-top: 0.4rem; justify-content: center; }
  .btn[aria-busy='true'] { pointer-events: none; opacity: 0.75; }
  .btn[aria-busy='true']::after {
    content: ''; display: inline-block; width: 13px; height: 13px; margin-left: 9px;
    border: 2px solid currentColor; border-top-color: transparent; border-radius: 50%;
    vertical-align: -2px; animation: spin 0.6s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* the trailing links, tidy pair with one clear gap */
  .foot-links { margin-top: 1.3rem; display: flex; flex-direction: column; gap: 0.55rem; align-items: flex-start; }
  .resend { margin: 0; }
  .linkbtn { background: none; border: none; padding: 0; font: inherit; font-size: var(--step--1); color: var(--ink); cursor: pointer; }
  .linkbtn:hover { text-decoration: underline; }
  .linkbtn[aria-busy='true'] { opacity: 0.6; pointer-events: none; }
  .relink { font-size: var(--step--1); color: var(--ink); }
  .relink:hover { text-decoration: underline; }
  .back { display: block; margin-top: 1.4rem; font-size: var(--step--1); color: var(--text-muted); }
  .back:hover { color: var(--ink); }

  @media (prefers-reduced-motion: reduce) { .btn[aria-busy='true']::after { animation: none; } }
</style>
