---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import Wordmark from '../../components/Wordmark.astro';
import AuthField from '../../components/AuthField.astro';
import { createSupabaseServer, supabaseConfigured } from '../../lib/supabase';

const url = Astro.url;
let error = '';
let sent = false;

// Signed in, but the profile has no staff role. Said plainly — sign-up is open
// (comments need accounts), the admin is not.
const denied = url.searchParams.get('denied') === '1';
const nextPath = url.searchParams.get('next') ?? '/admin';

if (Astro.request.method === 'POST' && supabaseConfigured) {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();

  if (!email || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
    error = 'Enter a valid email address.';
  } else {
    const supabase = createSupabaseServer(Astro.request, Astro.cookies);
    const redirectTo = new URL('/admin/auth/callback', url.origin);
    redirectTo.searchParams.set('next', nextPath);

    const { error: authError } = await supabase.auth.signInWithOtp({
      email,
      options: {
        // auth-js defaults this to true, which would make the ADMIN login form an
        // unauthenticated account-creation endpoint. Staff accounts are invited,
        // never self-served. Public sign-up (for comments) gets its own route.
        shouldCreateUser: false,
        emailRedirectTo: redirectTo.href,
      },
    });

    if (authError) {
      // Always record the precise cause for the operator. Swallowing it entirely
      // once sent a real debugging session chasing SMTP when the API had actually
      // answered 422 otp_disabled.
      console.error('[admin-login] signInWithOtp failed', {
        code: (authError as { code?: string }).code,
        status: authError.status,
        message: authError.message,
      });

      // Shown to the visitor: still no yes/no on whether that specific address has
      // an account, but it names the actual rule instead of implying an outage.
      error =
        (authError as { code?: string }).code === 'otp_disabled'
          ? 'No link sent. Admin accounts are invited, not self-served.'
          : 'Could not send the link. Try again in a moment.';
    } else {
      sent = true;
    }
  }
}
---

<AdminLayout title="Sign in" chrome={false}>
  <AuthField />

  <div class="card">
    <Wordmark class="mark" />

    {!supabaseConfigured ? (
      <>
        <h2>Not configured yet</h2>
        <p class="note">
          Copy <code>.env.example</code> to <code>.env</code> and fill in your Supabase project URL
          and keys, then restart the dev server.
        </p>
      </>
    ) : sent ? (
      <>
        <h2>Check your email</h2>
        <p class="note">
          A one-time sign-in link is on its way. It expires shortly, and opening it brings you
          straight back here.
        </p>
      </>
    ) : (
      <>
        {denied && (
          <p class="alert">That account exists but has no admin access.</p>
        )}
        {error && <p class="alert">{error}</p>}

        <form method="POST" class="form">
          <label class="lbl" for="email">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="input"
          />
          <button class="btn btn-primary" type="submit">Email me a link</button>
        </form>
      </>
    )}

    <a class="back" href="/">← Back to site</a>
  </div>
</AdminLayout>

<style>
  .card {
    position: relative; z-index: 1;   /* above the fixed dot field */
    width: min(100%, 360px);
    border: 1px solid var(--border-strong); border-radius: 16px;
    /* translucent so the field reads through, blurred so the text stays crisp */
    background: rgba(18, 17, 16, 0.72);
    backdrop-filter: blur(14px);
    box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.9);
    padding: clamp(1.5rem, 1rem + 1.5vw, 2rem);
  }
  /* :global — the SVG carries Wordmark's own astro cid, so a scoped rule misses it */
  .card :global(.mark) { height: 19px; width: auto; color: var(--ink); }
  h2 { margin-top: 1.1rem; font-size: 1.3rem; letter-spacing: -0.02em; }
  .note { margin-top: 0.6rem; color: var(--text-muted); font-size: var(--step--1); line-height: 1.55; }
  .alert {
    margin-top: 0.9rem; padding: 0.6rem 0.75rem; border-radius: 9px;
    border: 1px solid var(--border-strong); background: var(--surface-2);
    color: var(--ink); font-size: var(--step--1);
  }
  .form { display: grid; gap: 0.5rem; margin-top: 1.4rem; }
  .lbl { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }
  .input {
    width: 100%; font: inherit; color: var(--ink);
    padding: 0.6em 0.75em; border-radius: 10px;
    border: 1px solid var(--border-control); background: var(--bg);
  }
  .input:focus { outline: 2px solid var(--ink); outline-offset: 1px; border-color: var(--ink); }
  .form button { margin-top: 0.4rem; justify-content: center; }
  code { font-family: var(--font-mono); font-size: 0.85em; color: var(--ink); }
  .back { display: inline-block; margin-top: 1.4rem; font-size: var(--step--1); color: var(--text-muted); }
  .back:hover { color: var(--ink); }
</style>
