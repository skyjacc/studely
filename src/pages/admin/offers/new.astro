---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import OfferFields from '../../../components/admin/OfferFields.astro';

const { profile } = Astro.locals;
if (!profile) return Astro.redirect('/admin/login', 302);

// The form submits to the offers.create action from the client; there is no
// server POST here. Defaults for a fresh draft:
const v: Record<string, any> = { offer_type: 'free', status: 'active', eligibility: 'Verified students worldwide' };
const errors: Record<string, string> = {};
---

<AdminLayout title="New offer" subtitle="Creates a draft — publish it when it's ready" handle={profile.handle} role={profile.role}>
  <a class="back" href="/admin/offers">← All offers</a>
  <p class="banner bad" data-form-error hidden></p>

  <form class="editor" id="offer-form">
    <OfferFields v={v} errors={errors} createMode={true} />
    <div class="actions">
      <button class="btn pri" type="submit">Create draft</button>
      <a class="btn" href="/admin/offers">Cancel</a>
    </div>
  </form>
</AdminLayout>

<script>
  import { bindOfferForm } from '../../../components/admin/offer-form-client';
  const form = document.getElementById('offer-form') as HTMLFormElement | null;
  if (form) bindOfferForm({ form, mode: 'create' });
</script>

<style>
  .back { display: inline-block; font-size: var(--step--1); color: var(--text-muted); margin-bottom: 1rem; }
  .back:hover { color: var(--ink); }
  .banner { padding: 0.7rem 1rem; border-radius: 10px; font-size: var(--step--1); margin-bottom: 1rem; border: 1px solid rgba(224,101,92,.3); color: #e88f88; background: rgba(224,101,92,.08); }
  .editor { max-width: 720px; }
  .actions { display: flex; gap: 12px; margin-top: 1.6rem; padding-top: 1.2rem; border-top: 1px solid var(--border); }
  .btn { display: inline-flex; align-items: center; font-size: var(--step--1); font-weight: 500; padding: 9px 16px; border-radius: 9px; border: 1px solid var(--border-strong); background: var(--surface); color: var(--ink); cursor: pointer; }
  .btn:hover { background: var(--surface-2); }
  .btn.pri { background: var(--ink); color: var(--surface); border-color: var(--ink); }
  .btn[disabled] { opacity: 0.6; pointer-events: none; }
</style>
