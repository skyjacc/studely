---
export const prerender = false;

import AdminLayout from '@ui/layouts/AdminLayout.astro';
import OfferFields from '@ui/components/admin/OfferFields.astro';
import { createSupabaseServer } from '@core/supabase';
import { attributeVocabulary } from '@domain/offers/offer-input';
import { getOfferForEdit } from '@domain/offers/admin-offers';

const { profile } = Astro.locals;
if (!profile) return Astro.redirect('/admin/login', 302);
const slug = Astro.params.slug!;
const supabase = createSupabaseServer(Astro.request, Astro.cookies);

const existing = await getOfferForEdit(supabase, slug);
if (!existing) return Astro.redirect('/admin/offers?missing=' + slug, 302);
const row = existing.row;

const fromRow = (r: Record<string, any>) => ({
  slug: r.slug, title: r.title, provider: r.provider, category: r.category,
  summary: r.summary, value: r.value, body: r.body, url: r.url,
  verification: r.verification, eligibility: r.eligibility, offer_type: r.offer_type,
  discount_percent: r.discount_percent ?? '', status: r.status,
  affiliate: r.affiliate, sponsored: r.sponsored, featured: r.featured,
  tags: Array.isArray(r.tags) ? r.tags.join(', ') : '',
  expires_at: r.expires_at ?? '',
});
const v = fromRow(row);
const attributeKeys: string[] = existing.attributeKeys;
const errors: Record<string, string> = {};

const done = Astro.url.searchParams.get('done');
const created = Astro.url.searchParams.get('created');
const deploy = Astro.url.searchParams.get('deploy');
let notice: string | null = null;
if (created) notice = 'Draft created. Set its attributes and publish when it is ready.';
const deployNotice = (verb: string) =>
  deploy === 'triggered'
    ? `${verb} Rebuild triggered.`
    : deploy === 'skipped'
      ? `${verb} Rebuild not triggered: deploy hook is not configured.`
      : deploy === 'failed'
        ? `${verb} Rebuild trigger failed; public site may still show the previous version.`
        : verb;
if (done === 'save') notice = deployNotice('Saved.');
if (done === 'publish') notice = deployNotice('Published.');
if (done === 'unpublish') notice = deployNotice('Unpublished.');
const noticeKind = deploy === 'failed' || deploy === 'skipped' ? 'warn' : 'ok';

const groups: [string, string][] = [['value', 'What you get'], ['access', 'How hard to claim'], ['durability', 'Durability']];
const checkedSet = new Set(attributeKeys);
---

<AdminLayout title={row.title as string} subtitle={`/offers/${slug}`} handle={profile.handle} role={profile.role}>
  <a class="back" href="/admin/offers">← All offers</a>
  {notice && <p class={`banner ${noticeKind}`}>{notice}</p>}
  <p class="banner bad" data-form-error hidden></p>

  <div class="layout">
    <form class="editor" id="offer-form" data-slug={slug}>
      <OfferFields v={v} errors={errors} createMode={false} />

      <div class="attrs">
        <div class="lb">Scoring attributes <em>every point is attributable · score recomputes on save</em></div>
        {groups.map(([gk, gl]) => (
          <div class="agroup">
            <span class="amono">{gl}</span>
            <div class="achips">
              {attributeVocabulary.filter((a) => a.group === gk).map((a) => (
                <label class={`achip ${checkedSet.has(a.key) ? 'on' : ''}`}>
                  <input type="checkbox" name="attr" value={a.key} checked={checkedSet.has(a.key)} />
                  <span>{a.label}</span>
                  <b class={a.points >= 0 ? 'pos' : 'neg'}>{a.points >= 0 ? `+${a.points}` : a.points}</b>
                </label>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="actions">
        <button class="btn pri" type="submit">Save changes</button>
        <a class="btn" href="/admin/offers">Done</a>
      </div>
    </form>

    <aside class="side">
      <div class="card">
        <div class="scorebox">
          <span class="score">{row.score}</span>
          <div><b>Studely score</b><span>derived from attributes</span></div>
        </div>
        <div class="vis"><span class={`pill v-${row.visibility}`}>{row.visibility}</span></div>
        {row.visibility === 'published' ? (
          <button class="btn wide" data-vis="unpublish" data-slug={slug}>Unpublish</button>
        ) : (
          <button class="btn wide pub" data-vis="publish" data-slug={slug}>Publish</button>
        )}
        <p class="hint">Publishing triggers a site rebuild so the change goes live.</p>
      </div>
      <button class="btn del" data-del data-slug={slug}>Delete offer</button>
    </aside>
  </div>
</AdminLayout>

<script>
  import { bindOfferForm } from '@ui/components/admin/offer-form-client';
  import { actions } from 'astro:actions';

  const form = document.getElementById('offer-form') as HTMLFormElement | null;
  if (form) bindOfferForm({ form, mode: 'edit', slug: form.dataset.slug });

  const banner = document.querySelector<HTMLElement>('[data-form-error]');
  const showErr = (m: string) => { if (banner) { banner.hidden = false; banner.textContent = m; } };

  for (const btn of document.querySelectorAll<HTMLButtonElement>('button[data-vis]')) {
    btn.addEventListener('click', async () => {
      const s = btn.dataset.slug!;
      const action = btn.dataset.vis!;
      const visibility = action === 'publish' ? 'published' : 'draft';
      btn.disabled = true;
      const { data, error } = await actions.offers.setVisibility({ slug: s, visibility });
      if (error || !data?.ok) { btn.disabled = false; showErr(error?.message ?? 'Could not change visibility'); return; }
      const p = new URLSearchParams({ done: action });
      if (data.deploy) p.set('deploy', data.deploy.status);
      location.assign(`/admin/offers/${s}?${p}`);
    });
  }

  const del = document.querySelector<HTMLButtonElement>('button[data-del]');
  del?.addEventListener('click', async () => {
    if (!confirm('Delete this offer permanently?')) return;
    del.disabled = true;
    const { data, error } = await actions.offers.remove({ slug: del.dataset.slug! });
    if (error || !data?.ok) { del.disabled = false; showErr(error?.message ?? 'Could not delete'); return; }
    const p = new URLSearchParams({ done: 'deleted' });
    if (data.deploy) p.set('deploy', data.deploy.status);
    location.assign(`/admin/offers?${p}`);
  });
</script>

<style>
  .back { display: inline-block; font-size: var(--step--1); color: var(--text-muted); margin-bottom: 1rem; }
  .back:hover { color: var(--ink); }
  .banner { padding: 0.7rem 1rem; border-radius: 10px; font-size: var(--step--1); margin-bottom: 1rem; border: 1px solid var(--border-strong); }
  .banner.ok { color: #7fd6b0; background: rgba(84,201,162,.08); border-color: rgba(84,201,162,.3); }
  .banner.warn { color: #e6bd78; background: rgba(224,164,74,.08); border-color: rgba(224,164,74,.3); }
  .banner.bad { color: #e88f88; background: rgba(224,101,92,.08); border-color: rgba(224,101,92,.3); }

  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 1.6rem; align-items: start; }
  .editor { min-width: 0; }
  .actions { display: flex; gap: 12px; margin-top: 1.6rem; padding-top: 1.2rem; border-top: 1px solid var(--border); }
  .btn { display: inline-flex; align-items: center; justify-content: center; font-size: var(--step--1); font-weight: 500; padding: 9px 16px; border-radius: 9px; border: 1px solid var(--border-strong); background: var(--surface); color: var(--ink); cursor: pointer; font-family: inherit; }
  .btn:hover { background: var(--surface-2); }
  .btn[disabled] { opacity: 0.6; pointer-events: none; }
  .btn.pri { background: var(--ink); color: var(--surface); border-color: var(--ink); }
  .btn.wide { width: 100%; }
  .btn.pub { background: rgba(84,201,162,.14); border-color: rgba(84,201,162,.4); color: #7fd6b0; }
  .btn.del { width: 100%; color: #e88f88; border-color: rgba(224,101,92,.35); background: transparent; }
  .btn.del:hover { background: rgba(224,101,92,.1); }

  .attrs { margin-top: 1.6rem; padding-top: 1.4rem; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 1rem; }
  .lb { font-size: 12.5px; color: var(--ink); font-weight: 500; }
  .lb em { font-style: normal; color: var(--text-muted); font-weight: 400; margin-left: 6px; }
  .agroup { display: flex; flex-direction: column; gap: 8px; }
  .amono { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: .14em; text-transform: uppercase; color: var(--text-muted); }
  .achips { display: flex; flex-wrap: wrap; gap: 8px; }
  .achip { display: inline-flex; align-items: center; gap: 8px; font-size: 12.5px; padding: 7px 11px; border-radius: 20px; border: 1px solid var(--border); background: var(--surface); cursor: pointer; color: var(--text-muted); transition: border-color .16s, color .16s, background .16s; }
  .achip:hover { border-color: var(--border-strong); color: var(--ink); }
  .achip.on { border-color: var(--ink); color: var(--ink); background: var(--surface-2); }
  .achip input { position: absolute; opacity: 0; width: 0; height: 0; }
  .achip b { font-variant-numeric: tabular-nums; font-weight: 600; }
  .achip b.pos { color: #54c9a2; } .achip b.neg { color: #e0a44a; }

  .side { display: flex; flex-direction: column; gap: 12px; position: sticky; top: 24px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 16px; display: flex; flex-direction: column; gap: 14px; }
  .scorebox { display: flex; align-items: center; gap: 12px; }
  .scorebox .score { width: 46px; height: 46px; flex: none; border-radius: 11px; display: grid; place-items: center; font-family: var(--font-display); font-weight: 600; font-size: 22px; border: 1px solid var(--border-strong); font-variant-numeric: tabular-nums; }
  .scorebox b { display: block; font-size: 13px; } .scorebox span { display: block; font-size: 11.5px; color: var(--text-muted); }
  .pill { font-size: 11px; font-weight: 500; padding: 3px 10px; border-radius: 20px; text-transform: capitalize; }
  .pill.v-published { background: rgba(84,201,162,.14); color: #6fd0ac; }
  .pill.v-draft { background: var(--surface-2); color: var(--text-muted); }
  .pill.v-archived { background: rgba(224,101,92,.12); color: #e0918a; }
  .hint { font-size: 11.5px; color: var(--text-muted); margin: 0; line-height: 1.5; }

  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; } .side { position: static; } }
  @media (prefers-reduced-motion: reduce) { .achip { transition: none; } }
</style>
