---
// The front index (Visual Direction v3 §1, plan §4). Not a homepage with a
// register attached: the head of the register itself. It orients in one screen
// — what this is, how to narrow it, what the words mean — and hands over.
//
// Everything an entry says is decided in the register's own model, so the five
// rows here are literally the first five of /offers. No second ranking, no
// "featured" block, and no home-only presentation of an offer.
import Layout from '@ui/layouts/Layout.astro';
import EntryRow from '@ui/components/EntryRow.astro';
import CategoryChips from '@ui/components/CategoryChips.astro';
import { getAllOffers } from '@domain/offers/offers-source';
import { entryRowModel } from '@ui/entry-row';
import { registerStatus } from '@ui/register-status';
import { defaultRegisterOrder } from '@domain/offers/order';
import { categories } from '@domain/offers/categories';
import { ATTRIBUTES } from '@domain/offers/attributes';
import { isExpired } from '@domain/offers/offers';
import { registerHref } from '@domain/offers/routes';
import { site } from '@core/config/site';

const SAMPLE = 5;

const all = (await getAllOffers()).filter((o) => !isExpired(o));
const status = registerStatus(all);
const sample = [...all].sort(defaultRegisterOrder).slice(0, SAMPLE);

const catFacets = categories
  .map((c) => ({ ...c, n: all.filter((o) => o.data.category === c.slug).length }))
  .filter((c) => c.n > 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  description: site.description,
  url: site.url,
};
---

<Layout
  title="Student benefits, scored and dated"
  description="A register of student offers: what each one is worth, how you prove you qualify, and when we last confirmed the link."
  jsonLd={jsonLd}
>
  <section class="front">
    <div class="wrap">
      <header class="head">
        <h1>Student benefits</h1>
        <p class="status">{status.text}</p>
      </header>

      <p class="instruction">
        Find what you're eligible for. Every entry shows how you prove it, what it is worth,
        and when we last confirmed the link.
      </p>

      <CategoryChips categories={catFacets} total={all.length} />

      <div class="rows">
        {sample.map((offer, i) => <EntryRow entry={entryRowModel(offer, i)} />)}
      </div>

      <p class="handover">
        <a href={registerHref()}>All {all.length} offers in the register →</a>
      </p>

      <!-- What the two words on every row actually mean. Both are written from
           what the data can support: the criteria count is the registry's own
           length, and the verification sentence disappears the day a human
           check lands rather than being edited by hand. -->
      <aside class="notes" aria-label="How to read the register">
        <section class="note">
          <h2>How a score is made</h2>
          <p>
            Every offer starts at 5. {ATTRIBUTES.length} named criteria add or subtract points,
            and the reasons are printed on every entry.
          </p>
          <p class="note-link"><a href="/methodology">The full list of criteria →</a></p>
        </section>
        <section class="note">
          <h2>What “checked” means</h2>
          <p>
            A weekly job fetches each offer's page. “Checked” means the link answered — it is not
            a human review{status.verified === 0 ? ', and no entry here is marked verified yet' : ''}.
          </p>
          <p class="note-link"><a href="/about">How we work →</a></p>
        </section>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .front { padding-block: var(--space-l) var(--space-m); }
  /* the rule runs the full width under the heading, as the register's does */
  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-xs); padding-bottom: var(--space-s); border-bottom: 1px solid var(--rule-strong); }
  h1 { font-size: var(--step-3); }
  .status { font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }

  .instruction { max-width: 62ch; margin-top: var(--space-s); font-size: var(--step-1); line-height: 1.4; }

  .rows { margin-top: var(--space-m); border-bottom: 1px solid var(--rule); }

  .handover { margin-top: var(--space-s); font-size: var(--step-0); }
  .handover a { border-bottom: 1px solid var(--rule-strong); padding-bottom: 0.15em; }
  .handover a:hover { border-bottom-color: var(--ink); }

  .notes {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-m); margin-top: var(--space-2xl);
    padding-top: var(--space-s); border-top: 1px solid var(--rule-strong);
  }
  .note h2 { font-family: var(--font-mono); font-size: var(--step--2); font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); }
  .note p { max-width: 54ch; margin-top: var(--space-2xs); font-size: var(--step--1); color: var(--text-muted); }
  .note-link { margin-top: var(--space-2xs); }
  .note-link a { color: var(--ink); border-bottom: 1px solid var(--rule); }
  .note-link a:hover { border-bottom-color: var(--ink); }
</style>
