<!-- The dropdown's button/listbox are created at runtime by the script above, so they
     carry no astro scope id and scoped rules never match them. Global, but every
     selector is namespaced under .sel / .sel-* which exist only here. -->
<style is:global>
  .sel .sel-btn {
    width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    font: inherit; font-weight: 500; font-size: var(--step--1); color: var(--ink);
    text-align: left; cursor: pointer;
    padding: 0.55em 0.7em; border-radius: 10px;
    border: 1px solid var(--border-control); background: var(--surface);
    transition: border-color 0.25s var(--ease-out);
  }
  .sel .sel-btn:hover, .sel.is-open .sel-btn { border-color: var(--ink); }
  .sel .sel-btn:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .sel .sel-val { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sel .sel-chev {
    width: 12px; height: 12px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.6;
    stroke-linecap: round; stroke-linejoin: round; transition: transform 0.35s var(--ease-out);
  }
  .sel.is-open .sel-chev { transform: rotate(180deg); }

  .sel .sel-list {
    position: absolute; z-index: 40; top: calc(100% + 6px); left: 0; right: 0;
    margin: 0; padding: 0.3rem; list-style: none; max-height: 260px; overflow-y: auto;
    background: var(--surface-2); border: 1px solid var(--border-control); border-radius: 12px;
