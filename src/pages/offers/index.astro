---
// The register (Visual Direction v3 §1, §3). Every offer is an entry row: the
// same model on desktop, in the table and on mobile, so no view can quietly
// disagree with another. The page composes and filters; what a row means is
// decided in the domain and read through entryRowModel.
import { getAllOffers } from '@domain/offers/offers-source';
import Layout from '@ui/layouts/Layout.astro';
import EntryRow from '@ui/components/EntryRow.astro';
import SegmentedControl from '@ui/components/SegmentedControl.astro';
import CategoryChips from '@ui/components/CategoryChips.astro';
import EmptyState from '@ui/components/EmptyState.astro';
import Sheet from '@ui/components/Sheet.astro';
import AdSlot from '@ui/components/AdSlot.astro';
import { entryRowModel } from '@ui/entry-row';
import { categories } from '@domain/offers/categories';
import { isExpired, daysUntil, verifyGroup, offerTypeLabel } from '@domain/offers/offers';
import { adAfterIndexes } from '@domain/ads/ads';
import { defaultRegisterOrder } from '@domain/offers/order';
import { registerStatus } from '@ui/register-status';
import { site } from '@core/config/site';

const all = (await getAllOffers()).filter((o) => !isExpired(o));
const sorted = [...all].sort(defaultRegisterOrder);
const status = registerStatus(all);
const entries = sorted.map((o, i) => ({ offer: o, row: entryRowModel(o, i) }));

// In-feed interruptions for the default order; the script keeps them in place
// while the register is pristine and hides them the moment it is narrowed.
// Only when a real in-feed unit is configured — otherwise the register is clean.
const adAt = new Set(site.adsense.slots.inFeed ? adAfterIndexes(sorted.length) : []);

const catFacets = categories
  .map((c) => ({ ...c, n: all.filter((o) => o.data.category === c.slug).length }))
  .filter((c) => c.n > 0);

const TYPES = ['free', 'discount', 'credit', 'trial'] as const;
const typeFacets = TYPES.map((t) => ({ t, label: offerTypeLabel[t], n: all.filter((o) => o.data.offerType === t).length })).filter((x) => x.n > 0);

const verifyFacets = [...new Set(all.map((o) => verifyGroup(o.data.proofMethod)))]
  .map((g) => ({ g, n: all.filter((o) => verifyGroup(o.data.proofMethod) === g).length }))
  .sort((a, b) => b.n - a.n);

// "No card required" is asserted, never inferred. Counting the ABSENCE of
// card_required silently vouched for every offer nobody had scored on that axis.
const noCardCount = all.filter((o) => o.attributes.some((a) => a.key === 'no_card_required')).length;

const daysLeft = (o: (typeof sorted)[number]) => {
  const d = daysUntil(o.data.expires);
  return d === null ? 999999 : d; // ongoing sorts last
};
const facetsOf = (o: (typeof sorted)[number]) => ({
  'data-cat': o.data.category,
  'data-type': o.data.offerType,
  'data-verify': verifyGroup(o.data.proofMethod),
  'data-score': String(o.data.score),
  'data-checked': String(o.data.lastChecked.getTime()),
  'data-expires': String(daysLeft(o)),
  'data-card': o.attributes.some((a) => a.key === 'no_card_required') ? 'no' : 'yes',
  'data-name': o.data.title.toLowerCase(),
  'data-text': `${o.data.title} ${o.data.provider} ${o.data.summary} ${o.data.tags.join(' ')}`.toLowerCase(),
});
---

<Layout title="The register — every student offer" description="Every student offer Studely holds, scored against clear criteria, with the date each link was last checked. Search, filter by category and sort in place.">
  <section class="register">
    <div class="wrap">
      <header class="head">
        <h1>The register</h1>
        <p class="status">{status.text}</p>
      </header>

      <!-- narrowing: search · sort · view -->
      <div class="controls">
        <form class="searchbox" role="search" action="/offers" method="get">
          <label class="sr-only" for="q">Search the register</label>
          <input id="q" name="q" class="qfield" type="search" placeholder="Search the register…" autocomplete="off" />
          <button type="submit" class="sr-only">Search</button>
        </form>
        <div class="sortview">
          <label class="ctl-label" for="sort">Sort</label>
          <select id="sort" class="select">
            <option value="score">Score: high → low</option>
            <option value="checked">Recently checked</option>
            <option value="expiring">Ending soon</option>
            <option value="az">Name: A → Z</option>
          </select>
          <SegmentedControl name="view" label="View" value="index" class="views"
            options={[{ value: 'index', label: 'Index', icon: 'rows' }, { value: 'table', label: 'Table', icon: 'grid' }]} />
        </div>
      </div>

      <!-- categories: the shared chip row. Here the script narrows in place. -->
      <CategoryChips categories={catFacets} total={all.length} />

      <div class="morebar">
        <details class="more" id="more">
          <summary>More filters<span class="ft-count" hidden></span></summary>
          <div id="more-host">
          <!-- The one facet node. It sits in the disclosure on desktop and moves
               into the Sheet below 900px: same inputs, same listeners, one DOM. -->
          <div id="facets" class="facets">
            <div class="fgroup sheet-only">
              <label class="flabel" for="sort-sheet">Sort</label>
              <select id="sort-sheet" class="select"></select>
            </div>
            <fieldset class="fgroup">
              <legend class="flabel">Type</legend>
              {typeFacets.map((t) => (
                <label class="check">
                  <input type="checkbox" data-facet="type" value={t.t} />
                  <span class="ctxt">{t.label}</span>
                  <span class="cn">{t.n}</span>
                </label>
              ))}
            </fieldset>
            <fieldset class="fgroup">
              <legend class="flabel">Proof</legend>
              {verifyFacets.map((v) => (
                <label class="check">
                  <input type="checkbox" data-facet="verify" value={v.g} />
                  <span class="ctxt">{v.g}</span>
                  <span class="cn">{v.n}</span>
                </label>
              ))}
            </fieldset>
            <fieldset class="fgroup">
              <legend class="flabel">Requirements</legend>
              <label class="check">
                <input type="checkbox" data-facet="card" value="no" />
                <span class="ctxt">No card required</span>
                <span class="cn">{noCardCount}</span>
              </label>
            </fieldset>
            <button id="reset" class="reset" type="button">Reset filters</button>
          </div>
          </div>
        </details>
        <button class="filter-toggle" type="button" data-sheet-open="filters" aria-controls="sheet-filters" aria-expanded="false">
          Filters &amp; sort<span class="ft-count" hidden></span>
        </button>
      </div>


      <p id="count" class="count" aria-live="polite">{all.length} of {all.length}</p>

      <div id="rows" class="rows">
        {entries.map(({ offer, row }, i) => (
          <>
            <EntryRow entry={row} facets={facetsOf(offer)} />
            {adAt.has(i) && (
              <div class="interruption" data-ad>
                <p class="ad-label">ADVERTISEMENT</p>
                <AdSlot format="in-feed" slot={site.adsense.slots.inFeed} />
              </div>
            )}
          </>
        ))}
      </div>

      <div id="table" class="tablewrap" hidden>
        <table>
          <thead>
            <tr><th class="c-n">#</th><th>Provider</th><th>Offer</th><th class="c-score">Score</th><th>Value</th><th>Proof</th><th>Checked</th><th class="c-act"><span class="sr-only">Action</span></th></tr>
          </thead>
          <tbody>
            {entries.map(({ offer, row }) => (
              <tr data-entry {...facetsOf(offer)}>
                <td class="c-n">{row.n}</td>
                <td class="t-prov">{row.provider}</td>
                <td class="t-title"><a href={row.href}>{row.title}</a></td>
                <td class="c-score"><span aria-label={row.score.label}>{row.score.text}</span></td>
                <td class="t-val">{row.value} · {row.typeWord}</td>
                <td class="t-proof" title={row.proof}>{row.proof}</td>
                <td class:list={['t-check', row.trust.tone && `tone-${row.trust.tone}`]}>
                  {/* the column header already says CHECKED: a plain stamp needs
                      only its date here. Anything else — a problem, a human
                      verification — still says what it is, in full. */}
                  {row.trust.kind === 'none' ? '—' : row.trust.kind === 'checked' ? row.trust.dateText : row.trust.text}
                </td>
                <td class="c-act"><a href={row.action.href} rel={row.action.rel} {...row.action.data}>{row.action.label}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <EmptyState id="empty" hidden title="No offers match" why="Loosen a filter, or reset them."
        action={{ label: 'Reset filters' }} recovery={{ label: `Browse all ${all.length} offers →`, href: '/offers' }} />

      <p class="endline" id="endline">{all.length} of {all.length} · end of register</p>
    </div>
  </section>

  <Sheet id="filters" title="Filters & sort" side="bottom">
    <div id="sheet-host"></div>
  </Sheet>
</Layout>

<script>
  import {
    emptyState, parseState, serializeState, hasDirectoryKeys, isPristine, matches, compare, emptyMessage, FACET_KEYS,
  } from '@domain/offers/directory-state';
  import type { DirectoryState, ItemFacets, FacetKey, SortKey } from '@domain/offers/directory-state';

  function setupRegister() {
    const rows = document.getElementById('rows');
    if (!rows || rows.dataset.bound) return; // only on /offers, once per page instance
    rows.dataset.bound = '1';
    const tbody = document.querySelector<HTMLElement>('#table tbody')!;
    const table = document.getElementById('table')!;
    const countEl = document.getElementById('count')!;
    const endEl = document.getElementById('endline')!;
    const emptyEl = document.getElementById('empty')!;
    const q = document.getElementById('q') as HTMLInputElement;
    const sortEl = document.getElementById('sort') as HTMLSelectElement;
    const sheetSort = document.getElementById('sort-sheet') as HTMLSelectElement;
    const total = rows.querySelectorAll('[data-entry]').length;
    const STORE_KEY = 'studely.offers.v1';
    let state: DirectoryState = emptyState();

    // The Sheet carries a second sort control; mirror the options rather than
    // maintaining two lists in the markup.
    sheetSort.innerHTML = sortEl.innerHTML;

    const facetSet = (facet: FacetKey) => {
      const out = new Set<string>();
      document.querySelectorAll<HTMLInputElement>(`input[data-facet="${facet}"]:checked`).forEach((el) => out.add(el.value));
      return out;
    };
    const facetsOf = (el: HTMLElement): ItemFacets => ({
      text: el.dataset.text || '', cat: el.dataset.cat || '', type: el.dataset.type || '', verify: el.dataset.verify || '', card: el.dataset.card || '',
      score: +(el.dataset.score || 0), checked: +(el.dataset.checked || 0), expires: +(el.dataset.expires || 999999), name: el.dataset.name || '',
    });

    // URL wins; localStorage only fills in when the URL carries no directory key.
    const hydrate = () => {
      const url = new URLSearchParams(location.search);
      let src = url;
      if (!hasDirectoryKeys(url)) {
        try { const stored = localStorage.getItem(STORE_KEY); if (stored) src = new URLSearchParams(stored); } catch (e) {}
      }
      state = parseState(src);
      q.value = src.get('q') || '';
      sortEl.value = state.sort;
      sheetSort.value = state.sort;
      for (const f of FACET_KEYS) {
        document.querySelectorAll<HTMLInputElement>(`input[data-facet="${f}"]`).forEach((inp) => { inp.checked = state[f].has(inp.value); });
      }
      const viewInput = document.querySelector<HTMLInputElement>(`input[name="view"][value="${state.view}"]`);
      if (viewInput) viewInput.checked = true;
    };
    hydrate();

    const show = (el: HTMLElement) => matches(facetsOf(el), state);
    const cmp = (a: HTMLElement, b: HTMLElement) => compare(facetsOf(a), facetsOf(b), state.sort);

    // Live facet counts: a group is counted against every OTHER active filter.
    const updateFacets = () => {
      const items = [...rows.querySelectorAll<HTMLElement>('[data-entry]')];
      for (const facet of FACET_KEYS) {
        const pool = items.filter((el) => matches(facetsOf(el), state, facet));
        const inputs = [...document.querySelectorAll<HTMLInputElement>(`input[data-facet="${facet}"]`)];
        let anyVisible = false;
        inputs.forEach((input) => {
          const n = pool.filter((el) => el.dataset[facet] === input.value).length;
          const label = input.closest<HTMLElement>('.check')!;
          const cn = label.querySelector('.cn');
          if (cn) cn.textContent = String(n);
          const hide = n === 0 && !input.checked; // never hide a checked option
          label.hidden = hide;
          if (!hide) anyVisible = true;
        });
        const group = inputs[0]?.closest<HTMLElement>('.fgroup');
        if (group) group.hidden = !anyVisible;
      }
      // category chips carry their own counts, against the other facets
      const catPool = items.filter((el) => matches(facetsOf(el), state, 'cat'));
      document.querySelectorAll<HTMLElement>('[data-chip="cat"]').forEach((chip) => {
        const on = state.cat.has(chip.dataset.value!);
        const n = catPool.filter((el) => el.dataset.cat === chip.dataset.value).length;
        chip.querySelector('.cn')!.textContent = String(n);
        chip.classList.toggle('is-on', on);
        chip.setAttribute('aria-pressed', String(on));
        chip.hidden = n === 0 && !on;
      });
      const allChip = document.querySelector<HTMLElement>('[data-chip="all"]')!;
      allChip.classList.toggle('is-on', state.cat.size === 0);
      allChip.setAttribute('aria-pressed', String(state.cat.size === 0));
      allChip.querySelector('.cn')!.textContent = String(catPool.length);
    };

    const persist = () => {
      const qs = serializeState(state, q.value);
      // Preserve history.state — Astro's ClientRouter keeps its nav metadata there.
      history.replaceState(history.state, '', qs ? '?' + qs : location.pathname);
      try { localStorage.setItem(STORE_KEY, qs); } catch (e) {}
    };

    const updateFilterCount = () => {
      const n = FACET_KEYS.filter((f) => f !== 'cat').reduce((sum, f) => sum + state[f].size, 0);
      document.querySelectorAll<HTMLElement>('.ft-count').forEach((el) => {
        el.textContent = String(n);
        el.hidden = n === 0;
      });
    };

    const resetAll = () => {
      state.q = ''; q.value = '';
      document.querySelectorAll<HTMLInputElement>('input[data-facet]').forEach((el) => (el.checked = false));
      for (const f of FACET_KEYS) state[f].clear();
      state.sort = 'score'; sortEl.value = 'score'; sheetSort.value = 'score';
      apply();
    };

    const apply = () => {
      document.querySelectorAll<HTMLElement>('#table tbody tr').forEach((el) => { el.hidden = !show(el); });
      ([...tbody.children] as HTMLElement[]).sort(cmp).forEach((el) => tbody.appendChild(el));

      const ads = [...rows.querySelectorAll<HTMLElement>('[data-ad]')];
      const all = [...rows.querySelectorAll<HTMLElement>('[data-entry]')];
      const visible = all.filter(show).sort(cmp);
      // The interruption belongs to the untouched default browse only: an ad must
      // never trail a filtered subset, or claim a position in an order it was not
      // placed in. Its cadence mirrors src/domain/ads/ads.ts.
      const pristine = isPristine(state);
      const AD_INTERVAL = 6;
      const frag = document.createDocumentFragment();
      let adi = 0;
      visible.forEach((el, i) => {
        el.hidden = false;
        frag.appendChild(el);
        if (pristine && adi < ads.length && (i + 1) % AD_INTERVAL === 0 && i + 1 < visible.length) {
          ads[adi].hidden = false; frag.appendChild(ads[adi]); adi++;
        }
      });
      all.forEach((el) => { if (!visible.includes(el)) { el.hidden = true; frag.appendChild(el); } });
      ads.slice(adi).forEach((a) => { a.hidden = true; frag.appendChild(a); });
      rows.appendChild(frag);

      countEl.textContent = `${visible.length} of ${total}`;
      endEl.textContent = `${visible.length} of ${total} · end of register`;
      const none = visible.length === 0;
      emptyEl.hidden = !none;
      endEl.hidden = none;
      if (none) {
        const m = emptyMessage(state, q.value);
        emptyEl.querySelector('[data-empty-title]')!.textContent = m.title;
        emptyEl.querySelector('[data-empty-why]')!.textContent = m.why;
      }
      // The recovery link is only a recovery while a category is narrowing the register.
      const recovery = emptyEl.querySelector<HTMLElement>('[data-empty-recovery]');
      if (recovery) recovery.hidden = !(none && state.cat.size > 0);
      updateFacets();
      persist();
      updateFilterCount();
    };

    q.addEventListener('input', () => { state.q = q.value.trim().toLowerCase(); apply(); });
    for (const sel of [sortEl, sheetSort]) {
      sel.addEventListener('change', () => {
        state.sort = sel.value as SortKey;
        sortEl.value = state.sort; sheetSort.value = state.sort;
        apply();
      });
    }
    document.querySelectorAll<HTMLInputElement>('input[data-facet]').forEach((el) =>
      el.addEventListener('change', () => { for (const f of FACET_KEYS) state[f] = facetSet(f); apply(); }),
    );
    document.getElementById('reset')!.addEventListener('click', resetAll);
    emptyEl.querySelector('[data-empty-reset]')?.addEventListener('click', resetAll);
    emptyEl.querySelector('[data-empty-recovery]')?.addEventListener('click', (e) => {
      e.preventDefault();
      state.cat.clear();
      apply();
    });
    // The palette's Enter on this page filters in place instead of reloading.
    document.addEventListener('studely:search', (e) => {
      q.value = String((e as CustomEvent).detail || '');
      state.q = q.value.trim().toLowerCase();
      apply();
    });

    // Category chips are filters, not navigations: they refine in place. The href
    // stays real, so they work without JS and are shareable.
    document.querySelector('.chips')!.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLElement>('[data-chip]');
      if (!chip) return;
      e.preventDefault();
      if (chip.dataset.chip === 'all') state.cat.clear();
      else {
        const v = chip.dataset.value!;
        state.cat.has(v) ? state.cat.delete(v) : state.cat.add(v);
      }
      apply();
    });

    // view: a radiogroup (SegmentedControl); the native radios own the keyboard model
    const setView = (view: 'index' | 'table') => {
      const isTable = view === 'table';
      table.hidden = !isTable; rows.hidden = isTable;
      state.view = view;
      persist();
    };
    document.querySelectorAll<HTMLInputElement>('input[name="view"]').forEach((r) =>
      r.addEventListener('change', () => { if (r.checked) setView(r.value as 'index' | 'table'); }),
    );
    setView(state.view); // reflect the hydrated / stored view

    // The ONE facet node moves into the Sheet below 900px and back into the
    // disclosure above it. Same inputs, same listeners, one DOM.
    const facets = document.getElementById('facets')!;
    const deskHost = document.getElementById('more-host')!;
    const sheetHost = document.getElementById('sheet-host')!;
    const narrow = matchMedia('(max-width: 900px)');
    const place = () => (narrow.matches ? sheetHost : deskHost).appendChild(facets);
    narrow.addEventListener('change', place);
    place();

    apply();
  }
  document.addEventListener('astro:page-load', setupRegister);
  setupRegister();
</script>

<style>
  .register { padding-block: var(--space-l) var(--space-2xl); }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-xs); }
  h1 { font-size: var(--step-3); }
  .status { font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }

  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-s); margin-top: var(--space-m); padding-top: var(--space-s); border-top: 1px solid var(--rule-strong); }
  .searchbox { flex: 1 1 22rem; min-width: 0; }
  .qfield { width: 100%; font: inherit; color: var(--ink); background: var(--bg); padding: 0.6em 0.2em; border: 0; border-bottom: 1px solid var(--rule-control); }
  .qfield::placeholder { color: var(--text-muted); }
  .qfield:focus { border-bottom-color: var(--ink); }
  .qfield:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .sortview { display: flex; align-items: center; gap: var(--space-2xs); }
  .ctl-label { font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }
  .select { font: inherit; font-size: var(--step--1); color: var(--ink); background: var(--bg); border: 1px solid var(--rule-control); border-radius: 2px; padding: 0.4em 0.5em; }
  .select:focus-visible { outline: 2px solid var(--ink); outline-offset: 1px; }
  /* the chip row is CategoryChips; only its place in this page's rhythm is here */
  :global(.chips) { margin-top: var(--space-s); }

  .morebar { display: flex; align-items: center; gap: var(--space-s); margin-top: var(--space-s); }
  .more summary { display: inline-flex; align-items: center; gap: 0.5em; cursor: pointer; font-size: var(--step--1); color: var(--text-muted); list-style: none; }
  .more summary::-webkit-details-marker { display: none; }
  .more summary::before { content: '+'; font-family: var(--font-mono); }
  .more[open] summary::before { content: '−'; }
  .more summary:hover { color: var(--ink); }
  .ft-count { font-family: var(--font-mono); font-size: var(--step--2); padding: 0 0.4em; background: var(--ink); color: var(--bg); }
  .ft-count[hidden] { display: none; }
  .filter-toggle { display: none; align-items: center; gap: 0.5em; font: inherit; font-size: var(--step--1); color: var(--ink); background: none; border: 1px solid var(--rule-control); border-radius: 2px; padding: 0.5em 0.9em; cursor: pointer; }

  .facets { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: var(--space-s) var(--space-m); padding: var(--space-s) 0; }
  .fgroup { border: 0; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
  .fgroup[hidden] { display: none; }
  .sheet-only { display: none; }
  .flabel { font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }
  .check { display: flex; align-items: baseline; gap: 0.5em; cursor: pointer; font-size: var(--step--1); color: var(--text-muted); }
  .check[hidden] { display: none; }
  .check input { accent-color: var(--ink); }
  .check:hover, .check:has(input:checked) { color: var(--ink); }
  .check .ctxt { flex: 1; min-width: 0; }
  .check .cn { font-family: var(--font-mono); font-size: var(--step--2); font-variant-numeric: tabular-nums; }
  .reset { align-self: start; font: inherit; font-size: var(--step--1); color: var(--text-muted); background: none; border: 0; padding: 0; cursor: pointer; border-bottom: 1px solid var(--rule); }
  .reset:hover { color: var(--ink); border-bottom-color: var(--ink); }

  .count { font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-top: var(--space-m); }
  .rows { margin-top: var(--space-2xs); border-bottom: 1px solid var(--rule); }
  .rows[hidden] { display: none; }

  /* the interruption: bounded by rules, given more room than a row, and carrying
     none of an entry's slots — it must never read as the next offer */
  .interruption { padding: var(--space-l) 0; border-top: 1px solid var(--rule); text-align: center; }
  .interruption[hidden] { display: none; }
  .ad-label { font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.2em; color: var(--text-muted); margin-bottom: var(--space-xs); }

  .endline { font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-top: var(--space-s); }
  .endline[hidden] { display: none; }

  /* table: the same entries, aligned. One dataset, one derivation. */
  .tablewrap { margin-top: var(--space-2xs); overflow-x: auto; }
