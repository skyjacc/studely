  @media (prefers-reduced-motion: reduce) { .sel .sel-list { animation: none; } }

  .sel .sel-opt {
    position: relative; isolation: isolate;
    display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    padding: 0.45em 0.6em; border-radius: 8px; cursor: pointer;
