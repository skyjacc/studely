---
// The record (Visual Direction v3 §4). Six questions, fixed order, opening with
// the same row the register shows so the reader never re-learns the offer.
//
// Everything it prints comes from recordModel: the score and its reasons as the
// database recorded them, the two trust layers side by side, the outbound
// action through /go, and a history built only from rows that exist.
import { marked } from 'marked';
import { getAllOffers, getOfferHistory } from '@domain/offers/offers-source';
import Layout from '@ui/layouts/Layout.astro';
import EntryRow from '@ui/components/EntryRow.astro';
import RecordBox from '@ui/components/RecordBox.astro';
import AdSlot from '@ui/components/AdSlot.astro';
import { recordModel } from '@ui/record';
import { getCategory } from '@domain/offers/categories';
import { defaultRegisterOrder } from '@domain/offers/order';
import { categoryHref, registerHref } from '@domain/offers/routes';
import { site } from '@core/config/site';
import { isExpired } from '@domain/offers/offers';

export async function getStaticPaths() {
  const offers = await getAllOffers();
  return offers.map((offer) => ({ params: { id: offer.slug }, props: { offer } }));
}

const { offer } = Astro.props;
const d = offer.data;
const cat = getCategory(d.category);
const bodyHtml = await marked.parse(offer.body);

// One register order for the whole site: the record's number, and the numbers
// on the related rows, are positions in the same list /offers shows.
const register = (await getAllOffers()).filter((o) => !isExpired(o)).sort(defaultRegisterOrder);
const rankOf = new Map(register.map((o, i) => [o.slug, i + 1]));
const related = register
  .filter((o) => o.data.category === d.category && o.slug !== offer.slug)
  .slice(0, 3)
  .map((o) => ({ offer: o, rank: rankOf.get(o.slug) ?? 0 }));

const record = recordModel({
  offer,
  rank: rankOf.get(offer.slug) ?? register.length,
  total: register.length,
  related,
  history: await getOfferHistory(offer.slug),
});

const pageUrl = new URL(record.entry.href, site.url).href;
// Product + nested Offer is an eligible rich result (a bare Offer is not); add a BreadcrumbList.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name: d.title,
      description: d.summary,
      brand: { '@type': 'Brand', name: d.provider },
      category: cat?.name ?? d.category,
      offers: {
        '@type': 'Offer',
        url: pageUrl,
        priceCurrency: 'USD',
        price: d.offerType === 'free' ? '0' : undefined,
        availability: isExpired(offer) ? 'https://schema.org/Discontinued' : 'https://schema.org/InStock',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'The register', item: new URL(registerHref(), site.url).href },
        { '@type': 'ListItem', position: 2, name: cat?.name ?? d.category, item: new URL(categoryHref(d.category), site.url).href },
        { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
      ],
    },
  ],
};

const HISTORY_LABEL = {
  check: 'Automated link check',
  verification: 'Human verification',
  ends: 'Offer ends',
} as const;
---

<Layout title={d.title} description={d.summary} jsonLd={jsonLd} noindex={isExpired(offer)}>
  <article class="record-page">
    <div class="wrap">
      <nav class="back" aria-label="Breadcrumb">
        <a href={registerHref()}>← Register</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href={categoryHref(d.category)}>{cat?.name ?? d.category}</a>
        <span class="position">{record.position}</span>
      </nav>

      <!-- 1. what is it — the register row, then the one-line summary -->
      <header class="head" data-q="what is it">
        <p class="provider">{record.entry.provider}</p>
        <h1>{record.entry.title}</h1>
        <p class="score" aria-label={record.entry.score.label}>
          <span class="num" aria-hidden="true">{record.entry.score.text}</span>
          <span class="word" aria-hidden="true">{record.entry.score.word}</span>
        </p>
        <p class="summary">{record.summary}</p>
      </header>

      <div class="columns">
        <div class="main">
          <!-- 2. what do I get -->
          <section class="block" data-q="what do I get">
            <h2>What you get</h2>
            <p class="value">{record.whatYouGet.value}<span class="sep" aria-hidden="true"> · </span><span class="type">{record.whatYouGet.typeWord}</span></p>
          </section>

          {record.why.reasons.length > 0 && (
            <section class="block why" aria-label="Why this score">
              <h2>{record.why.heading}</h2>
              <ul class="reasons">
                {record.why.reasons.map((r) => (
                  <li><span class="rl">{r.label}</span><b class={r.points >= 0 ? 'pos' : 'neg'}>{r.points >= 0 ? `+${r.points}` : r.points}</b></li>
                ))}
              </ul>
              <p class="base">{record.why.base} <a href={record.why.methodologyHref}>How every criterion works →</a></p>
            </section>
          )}
        </div>

        <!-- 3. who qualifies · 4. why trust it · 5. what do I do · 6. where does it go -->
        <div class="side">
          <RecordBox box={record.box} action={record.action} />
        </div>
      </div>

      <section class="block account">
        <h2>The account</h2>
        <div class="prose body" set:html={bodyHtml}></div>
      </section>

      {site.adsense.slots.inArticle && (
        <aside class="ad" aria-label="Advertisement">
          <p class="ad-label">ADVERTISEMENT</p>
          <AdSlot format="in-article" slot={site.adsense.slots.inArticle} />
        </aside>
      )}

      {record.history.length > 0 && (
        <section class="block history">
          <h2>Record history</h2>
          <ol class="events">
            {record.history.map((e) => (
              <li>
                <time datetime={e.at.toISOString()}>{e.at.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}</time>
                <span class="what">
                  {HISTORY_LABEL[e.kind]}
                  {e.kind === 'check' && <span class="outcome"> · {e.result === 'pass' ? 'passed' : e.note ? `could not confirm (${e.note})` : 'could not confirm'}</span>}
                  {e.kind === 'verification' && <span class="outcome"> · {e.result === 'pass' ? 'passed' : 'did not pass'}</span>}
                </span>
              </li>
            ))}
          </ol>
        </section>
      )}

      {record.related.length > 0 && (
        <section class="block related">
          <h2>More in {cat?.name ?? d.category}</h2>
          <div class="rows">
            {record.related.map((entry) => <EntryRow entry={entry} />)}
          </div>
        </section>
      )}
    </div>
  </article>
</Layout>

<script>
  // One event on the money path. No-op until an analytics tool is added; the
  // durable record is the offer_clicks row written by /go.
  for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-go]')) {
    a.addEventListener('click', () => {
      const d = a.dataset;
      (window as any).plausible?.('offer_clicked', {
        props: { slug: d.slug, category: d.category, type: d.type, sponsored: d.sponsored === '1', affiliate: d.affiliate === '1' },
      });
    });
  }
</script>

<style>
  /* the height the mobile action bar occupies (button + destination + money,
     measured at 390px). Declared on the root so the reservation below can be
     made on <body> — the footer sets its own padding, and competing with it
     for the last line of the page is a fight this would lose quietly. */
  :global(:root) { --record-bar: 7rem; }
  .record-page { padding-block: var(--space-l) var(--space-2xl); }

  .back { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5em; font-size: var(--step--1); color: var(--text-muted); }
  .back a { color: var(--ink); border-bottom: 1px solid var(--rule); }
  .back a:hover { border-bottom-color: var(--ink); }
  .position { margin-left: auto; font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.12em; text-transform: uppercase; }

  .head { margin-top: var(--space-s); padding-bottom: var(--space-s); border-bottom: 1px solid var(--rule-strong); position: relative; }
  .provider { font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); }
  h1 { font-size: var(--step-3); margin-top: 0.1em; max-width: 24ch; }
  .score { position: absolute; top: 0; right: 0; text-align: right; }
  .score .num { display: block; font-family: var(--font-display); font-weight: 600; font-size: var(--step-1); font-variant-numeric: tabular-nums; }
  .score .word { display: block; font-size: var(--step--1); color: var(--text-muted); }
  .summary { margin-top: var(--space-2xs); max-width: 66ch; font-size: var(--step-0); color: var(--text-muted); }

  .columns { display: grid; grid-template-columns: minmax(0, 1fr) 22rem; gap: var(--space-m); align-items: start; margin-top: var(--space-m); }
  .side { position: sticky; top: calc(var(--nav-h) + var(--space-s)); }

  .block { margin-top: var(--space-l); }
  .block:first-child { margin-top: 0; }
  .block h2 { font-family: var(--font-mono); font-size: var(--step--2); font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); }
  .value { margin-top: var(--space-2xs); font-size: var(--step-1); }
  .value .type { color: var(--text-muted); }

  .why { margin-top: var(--space-m); }
  .reasons { list-style: none; margin: var(--space-2xs) 0 0; padding: 0; max-width: 46ch; }
  .reasons li { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-s); padding: 0.45em 0; border-top: 1px solid var(--rule); font-size: var(--step--1); }
  .reasons li:first-child { border-top: 0; }
  .reasons b { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .reasons .neg { color: var(--state-warn-ink); }
  .base { margin-top: var(--space-2xs); max-width: 46ch; font-size: var(--step--2); color: var(--text-muted); }
  .base a { color: var(--ink); border-bottom: 1px solid var(--rule); }

  .account { margin-top: var(--space-xl); }
  .body { margin-top: var(--space-xs); max-width: 70ch; }

  .ad { margin-top: var(--space-xl); padding-top: var(--space-s); border-top: 1px solid var(--rule); }
  .ad-label { font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.2em; color: var(--text-muted); margin-bottom: var(--space-2xs); }

  .events { list-style: none; margin: var(--space-2xs) 0 0; padding: 0; max-width: 60ch; }
  .events li { display: flex; gap: var(--space-s); padding: 0.5em 0; border-top: 1px solid var(--rule); font-size: var(--step--1); }
  .events time { flex: none; width: 9rem; font-family: var(--font-mono); font-variant-numeric: tabular-nums; color: var(--text-muted); }
  .events .outcome { color: var(--text-muted); }

  .related .rows { margin-top: var(--space-2xs); border-bottom: 1px solid var(--rule); }

  @media (max-width: 900px) {
    /* the record box comes right after the header, so the trust layers are read
       before the account; the action itself is a fixed bar (RecordBox), and
       this is the space reserved for it — at the end of the page and under the
       footer, so the bar never sits on top of anything */
    :global(body) { padding-bottom: calc(var(--record-bar) + var(--space-s)); }
    .columns { grid-template-columns: 1fr; gap: var(--space-s); }
    .side { position: static; }
    .main { order: 2; }
    .score { position: static; margin-top: var(--space-2xs); text-align: left; }
    .score .num, .score .word { display: inline; }
    .score .word { margin-left: 0.5em; }
    .events li { flex-direction: column; gap: 0.15em; }
    .events time { width: auto; }
  }
</style>
