---
import { marked } from 'marked';
import { getAllOffers } from '@domain/offers/offers-source';
import Layout from '@ui/layouts/Layout.astro';
import OfferPreview from '@ui/components/OfferPreview.astro';
import Score from '@ui/components/Score.astro';
import TrustRow from '@ui/components/TrustRow.astro';
import OfferCTA from '@ui/components/OfferCTA.astro';
import AdSlot from '@ui/components/AdSlot.astro';
import Badge from '@ui/components/Badge.astro';
import StateBadge from '@ui/components/StateBadge.astro';
import Logo from '@ui/components/Logo.astro';
import { getCategory } from '@domain/offers/categories';
import { site } from '@core/config/site';
import { offerTypeLabel, isExpiringSoon, isExpired, sortOffers } from '@domain/offers/offers';

export async function getStaticPaths() {
  const offers = await getAllOffers();
  return offers.map((offer) => ({ params: { id: offer.slug }, props: { offer } }));
}

const { offer } = Astro.props;
const d = offer.data;
const cat = getCategory(d.category);
const bodyHtml = await marked.parse(offer.body);

const related = sortOffers(
  (await getAllOffers()).filter(
    (o) => o.data.category === d.category && o.id !== offer.id && !isExpired(o),
  ),
).slice(0, 3);


// Score breakdown, strongest reasons first — every point is attributable.
const scoreAttrs = [...offer.attributes].sort((a, b) => b.points - a.points);

// Long ledger values stack (label above, value full-width left) on mobile so
// they don't wrap ragged against the right edge; short ones stay inline.
const STACK_AT = 20;

const pageUrl = new URL(`/offers/${offer.id}`, site.url).href;
// Product + nested Offer is an eligible rich result (a bare Offer is not); add a BreadcrumbList.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name: d.title,
      description: d.summary,
      brand: { '@type': 'Brand', name: d.provider },
      category: cat?.name ?? d.category,
      offers: {
        '@type': 'Offer',
        url: pageUrl,
        priceCurrency: 'USD',
        price: d.offerType === 'free' ? '0' : undefined,
        availability: isExpired(offer) ? 'https://schema.org/Discontinued' : 'https://schema.org/InStock',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Offers', item: new URL('/offers', site.url).href },
        { '@type': 'ListItem', position: 2, name: cat?.name ?? d.category, item: new URL(`/offers?cat=${d.category}`, site.url).href },
        { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
      ],
    },
  ],
};
---

<Layout title={d.title} description={d.summary} jsonLd={jsonLd} noindex={isExpired(offer)}>
  <article class="section">
    <div class="wrap layout">
      <div class="identity">
        <nav class="crumbs muted">
          <a href="/offers">Offers</a> <span aria-hidden="true">›</span>{' '}
          <a href={`/offers?cat=${d.category}`}>{cat?.name ?? d.category}</a>
        </nav>

        <div class="head" style={`--cat:${cat?.accent ?? 'var(--accent)'}`}>
          <span class="logo logo-tile"><Logo provider={d.provider} /></span>
          <div>
            <p class="provider muted" data-enter>{d.provider}</p>
            <h1 data-split>{d.title}</h1>
          </div>
        </div>

        <div class="badges" data-enter>
          {d.discountPercent && <Badge variant="discount" label={`${d.discountPercent}% off`} />}
          {d.sponsored && <StateBadge state="sponsored" />}
          {isExpiringSoon(offer) && <Badge variant="expiring" label="Ending soon" />}
        </div>

        <p class="lead summary" data-enter>{d.summary}</p>
      </div>

      <aside class="side">
        <div class="card hero-cta" data-enter>
          <p class="hc-lbl">Student value</p>
          <p class="hc-value" style={`--cat:${cat?.accent ?? 'var(--accent)'}`}>{d.value}<span class="hc-type muted"> · {offerTypeLabel[d.offerType] ?? d.offerType}</span></p>
          <OfferCTA offer={offer} placement="detail" />
        </div>
      </aside>

      <div class="content">
        {scoreAttrs.length > 0 && (
          <section class="scoreproof" aria-label="Why this score" data-reveal>
            <div class="sp-head">
              <Score score={d.score} variant="block" describedBy="sp-breakdown" />
              <div class="sp-cap">
                <span class="sp-t">Why this score</span>
                <span class="sp-s">Every point is a named reason — not a gut feeling.</span>
              </div>
            </div>
            <ul class="sp-breakdown" id="sp-breakdown" data-reveal-group>
              {scoreAttrs.map((a) => (
                <li>
                  <span class="sp-bl">{a.label}</span>
                  <b class={a.points >= 0 ? 'pos' : 'neg'}>{a.points >= 0 ? `+${a.points}` : a.points}</b>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="rec" aria-label="Offer record" data-reveal>
          <h2 class="sec-h">Offer record</h2>
          <TrustRow offer={offer} variant="full" />
          <dl class="rec-list">
            <div class:list={[{ stack: `Official ${d.provider} page`.length > STACK_AT }]}><dt>Source</dt><dd><a class="rec-link" href={d.url} target="_blank" rel="nofollow noopener">Official {d.provider} page ↗</a></dd></div>
          </dl>
        </section>

        <div class="prose body" set:html={bodyHtml} data-reveal></div>

        {site.adsense.slots.inArticle && (
          <div class="in-article"><AdSlot format="in-article" slot={site.adsense.slots.inArticle} /></div>
        )}

        <section class="rec" aria-label="Terms" data-reveal>
          <h2 class="sec-h">Terms</h2>
          <dl class="rec-list" data-reveal-group>
            <div><dt>Offer duration</dt><dd>{d.expires === 'ongoing' ? 'Ongoing' : d.expires}</dd></div>
          </dl>
        </section>


        {related.length > 0 && (
          <section class="related">
            <h2 class="rel-h" data-reveal>More in {cat?.name ?? d.category}</h2>
            <div class="grid grid-offers" data-reveal-group>
              {related.map((o) => <OfferPreview offer={o} />)}
            </div>
          </section>
        )}
      </div>
    </div>
  </article>
</Layout>

<script>
  // One event on the money path. No-op until an analytics tool (Plausible/PostHog)
  // is added; the durable record is the offer_clicks row written by /go.
  for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-go]')) {
    a.addEventListener('click', () => {
      const d = a.dataset;
      (window as any).plausible?.('offer_clicked', {
        props: { slug: d.slug, category: d.category, type: d.type, sponsored: d.sponsored === '1', affiliate: d.affiliate === '1' },
      });
    });
  }
</script>

<style>
  /* three zones: identity (top-left), value+CTA (right, sticky), content (below
     identity). On desktop the CTA card sits top-right, aligned with the title;
     on mobile the order is identity → value+CTA → content (title before CTA,
     CTA still high on the page). */
  .layout {
    display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 2rem 2.5rem;
    grid-template-areas: "identity side" "content side"; align-items: start;
  }
  .identity { grid-area: identity; }
  .content { grid-area: content; min-width: 0; }
  .side { grid-area: side; position: sticky; top: 84px; }

  .crumbs { font-size: var(--step--1); margin-bottom: 1rem; }
  .crumbs a:hover { color: var(--accent-ink); }
  .head { display: flex; gap: 1rem; align-items: center; }
  .head .logo {
    width: 66px; height: 66px; flex: none; color: var(--ink);
    border-radius: 16px; background: color-mix(in srgb, var(--cat) 14%, var(--surface));
  }
  .head h1 { font-size: clamp(1.7rem, 1.2rem + 2.2vw, 2.55rem); line-height: 1.05; letter-spacing: -0.03em; }
  .provider { font-weight: 600; letter-spacing: 0.02em; }
  .badges { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.1rem; }
  .summary { margin-top: 1rem; max-width: 60ch; }

  /* hero value + CTA card */
  .hero-cta { padding: 1.5rem 1.4rem; }
  .hc-lbl { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); }
  .hc-value { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.5rem, 1.2rem + 1.3vw, 1.95rem); letter-spacing: -0.02em; color: var(--ink); margin-top: 0.25rem; }
  .hero-cta :global(.cta-block) { margin-top: 1.1rem; }
  .hero-cta :global(.go) { width: 100%; justify-content: center; }
  .hc-type { font-size: 0.72em; font-weight: 400; }

  /* Why this score — the main proof, first in the content flow */
  .scoreproof { border: 1px solid var(--border-strong); border-radius: 14px; padding: 1.1rem 1.25rem; background: var(--surface); }
  .sp-head { display: flex; align-items: center; gap: 14px; }
  .sp-cap { display: flex; flex-direction: column; gap: 2px; }
  .sp-t { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: .14em; text-transform: uppercase; color: var(--text-muted); }
  .sp-s { font-size: var(--step--1); color: var(--ink); }
  .sp-breakdown { list-style: none; margin: 1rem 0 0; padding: 1rem 0 0; border-top: 1px dashed var(--border); display: grid; gap: 0.45rem; }
  .sp-breakdown li { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; font-size: var(--step--1); }
  .sp-bl { color: var(--ink); }
  .sp-breakdown b { font-variant-numeric: tabular-nums; font-weight: 600; flex: none; }
  .sp-breakdown b.pos { color: var(--ink); }
  .sp-breakdown b.neg { color: var(--state-warn-ink); }

  /* record ledgers — Offer record + Terms. Rows appear only for facts we hold. */
  .rec { margin-top: 2rem; }
  .sec-h { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin: 0 0 0.4rem; }
  .rec-list { margin: 0; border-top: 1px solid var(--border); }
  .rec-list > div { display: flex; align-items: baseline; justify-content: space-between; gap: 1.25rem; padding: 0.72rem 0; border-bottom: 1px solid var(--border-soft); }
  .rec-list dt { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); flex: none; }
  .rec-list dd { font-weight: 500; text-align: right; min-width: 0; }
  /* long values stack on mobile — label above, value full-width left (no ragged
     right-aligned wrapping). Short values stay inline. */
  @media (max-width: 640px) {
    .rec-list > div.stack { flex-direction: column; align-items: flex-start; gap: 0.15rem; }
    .rec-list > div.stack dd { text-align: left; }
  }
  .rec-link { color: var(--ink); border-bottom: 1px solid var(--border-strong); white-space: nowrap; }
  .rec-link:hover { color: var(--accent-ink); border-color: var(--accent-ink); }


  .body { margin-top: 2rem; }
  .in-article { margin: 2.5rem 0; }
  .related { margin-top: 2.5rem; }
  .rel-h { font-size: var(--step-1); letter-spacing: -0.02em; margin-bottom: 1rem; }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; grid-template-areas: "identity" "side" "content"; gap: 1.75rem; }
    .side { position: static; }
  }
</style>
