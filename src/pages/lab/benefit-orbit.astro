---
// LAB — Studely Benefit Orbit prototype (not linked, noindex). A standalone
// aesthetic test for a single strong offer (GitHub Student Developer Pack) to
// judge whether the "orbit of real facts" reads as Studely's own visual
// language before wiring anything into the live detail page.
//
// Rules honoured: only REAL offer facts as tokens; score charge = 5 base + 5
// earned (the 3 named reasons), never 10 fake points; CTA is in the DOM and
// clickable from 0ms (motion only fades it in); parallax + stagger are pointer-
// fine / motion-OK enhancements — coarse pointer, narrow screens and
// prefers-reduced-motion get the static composition. CSS/SVG only, no WebGL.
import Layout from '@ui/layouts/Layout.astro';

// Real GitHub Student Developer Pack facts (nothing invented).
const provider = 'GitHub';
const title = 'GitHub Student Developer Pack';
const category = 'Developer Tools';

// 5 tokens, each a real fact. `k` = the anchor a click would scroll to on the
// real page. Angles are laid out on the orbit ellipse (deg, 0 = right, cw).
const tokens = [
  { k: 'value', label: 'Value',       text: '$200k+ in tools',      angle: -90, depth: 1.0 },
  { k: 'incl',  label: 'Includes',    text: '100+ developer tools', angle: -18, depth: 0.7 },
  { k: 'elig',  label: 'Eligibility', text: 'SheerID',              angle: 54,  depth: 0.55 },
  { k: 'type',  label: 'Type',        text: 'Free',                 angle: 126, depth: 0.55 },
  { k: 'limit', label: 'Requires',    text: 'Current students',     angle: 198, depth: 0.7 },
];

// Score charge — honest: base 5 (neutral) + earned 5 from named reasons.
const scoreBase = 5;
const earned = [
  { reason: 'Bundle of many paid products', points: 3 },
  { reason: 'Instant student eligibility check', points: 1 },
  { reason: 'No payment method needed', points: 1 },
];
const earnedTotal = earned.reduce((s, e) => s + e.points, 0); // 5
const score = scoreBase + earnedTotal; // 10
// Segment model: 10 cells, first `scoreBase` are base, rest are earned.
const segments = Array.from({ length: 10 }, (_, i) => (i < scoreBase ? 'base' : 'earned'));
---

<Layout title="Benefit Orbit (lab)" noindex={true} chrome={false}>
  <main class="lab" data-orbit>
    <p class="eyebrow">{category}</p>
    <h1 class="title">{title}</h1>
    <p class="tagline">100+ paid developer tools, free with student eligibility.</p>

    <div class="stage" id="stage">
      <!-- connectors: hairlines from centre to each token -->
      <svg class="wires" viewBox="0 0 600 480" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <ellipse class="ring" cx="300" cy="240" rx="248" ry="176" />
        {tokens.map((t) => {
          const rad = (t.angle * Math.PI) / 180;
          const x = 300 + Math.cos(rad) * 248;
          const y = 240 + Math.sin(rad) * 176;
          return <line class="wire" x1="300" y1="240" x2={x} y2={y} data-k={t.k} />;
        })}
      </svg>

      <!-- centre: provider source mark -->
      <div class="mark" id="mark" tabindex="0" aria-label={`${provider} — official source`}>
        <span class="mark-frame">
          <svg viewBox="0 0 24 24" fill="currentColor" role="img" aria-label="GitHub logo" class="mark-logo"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        </span>
        <span class="mark-src">Official source</span>
      </div>

      <!-- tokens: absolutely positioned on the orbit, real facts only -->
      {tokens.map((t, i) => {
        const rad = (t.angle * Math.PI) / 180;
        const left = 50 + Math.cos(rad) * 41.3; // % (rx 248/600)
        const top = 50 + Math.sin(rad) * 36.7;  // % (ry 176/480)
        return (
          <button
            class="token"
            data-k={t.k}
            data-depth={t.depth}
            style={`left:${left}%; top:${top}%; --i:${i}`}
            aria-label={`${t.label}: ${t.text}`}
          >
            <span class="tk-label">{t.label}</span>
            <span class="tk-text">{t.text}</span>
          </button>
        );
      })}
    </div>

    <!-- score charge: 5 base + 5 earned, honest -->
    <div class="charge" role="img" aria-label={`Studely score ${score} of 10: 5 base plus ${earnedTotal} earned from ${earned.length} reasons`}>
      <span class="ch-num">{score}<i>/10</i></span>
      <span class="ch-bar">
        {segments.map((s, i) => <span class={`seg ${s}`} style={`--s:${i}`}></span>)}
      </span>
      <span class="ch-cap">5 base &middot; {earnedTotal} earned</span>
    </div>

    <a class="cta" href="#" data-cta>Get this offer <span aria-hidden="true">↗</span></a>
    <p class="cta-note">You&rsquo;ll continue to the official GitHub programme.</p>
  </main>
</Layout>

<style>
  .lab {
    min-height: 100vh; max-width: 760px; margin: 0 auto;
    padding: clamp(2rem, 1rem + 5vw, 5rem) 1.25rem 4rem;
    display: flex; flex-direction: column; align-items: center; text-align: center;
  }
  .eyebrow { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); }
  .title { font-family: var(--font-display); font-weight: 600; letter-spacing: -0.03em; line-height: 1.03; font-size: clamp(1.8rem, 1.2rem + 3vw, 3rem); margin-top: 0.5rem; }
  .tagline { color: var(--text-muted); margin-top: 0.7rem; max-width: 42ch; }

  /* ---- orbit stage ---- */
  .stage { position: relative; width: min(600px, 100%); aspect-ratio: 600 / 480; margin: clamp(1.5rem, 1rem + 3vw, 3rem) 0 0.5rem; }
  .wires { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .ring { fill: none; stroke: var(--border); stroke-dasharray: 2 6; }
  .wire { stroke: var(--border-strong); stroke-width: 1; opacity: 0; transition: opacity .3s var(--ease-out); }
  .stage.is-hot .wire[data-hot] { opacity: 1; }

  /* centre provider mark — logo inside a thin "printed" double frame */
  .mark {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%; z-index: 3;
    display: grid; place-items: center; gap: 0.5rem; cursor: default;
    will-change: transform;
  }
  .mark-frame {
    display: grid; place-items: center; width: 92px; height: 92px; color: var(--ink);
    background: var(--surface); border: 1px solid var(--border-strong); border-radius: 18px;
    box-shadow: 0 0 0 6px var(--bg), 0 0 0 7px var(--border), var(--shadow-soft);
    transition: box-shadow .4s var(--ease-out), border-color .4s var(--ease-out);
  }
  .mark-logo { width: 42px; height: 42px; }
  .mark-src {
    font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--text-muted); opacity: 0; translate: 0 -4px; transition: opacity .35s var(--ease-out), translate .35s var(--ease-out);
  }
  .mark:hover .mark-frame, .mark:focus-visible .mark-frame { border-color: var(--border-control); box-shadow: 0 0 0 6px var(--bg), 0 0 0 7px var(--border-strong), var(--shadow-soft); }
  .mark:hover .mark-src, .mark:focus-visible .mark-src { opacity: 1; translate: 0 0; }

  /* fact tokens */
  .token {
    position: absolute; translate: -50% -50%; z-index: 2;
    display: grid; gap: 2px; text-align: left; white-space: nowrap;
    padding: 0.5rem 0.8rem; border: 1px solid var(--border); border-radius: 12px;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    color: var(--ink); cursor: pointer; will-change: transform;
    transition: border-color .3s var(--ease-out), background .3s var(--ease-out), transform .3s var(--ease-out);
  }
  .token:hover { border-color: var(--border-control); background: var(--surface); transform: translate(-50%, -50%) scale(1.04); }
  .tk-label { font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }
  .tk-text { font-family: var(--font-display); font-weight: 500; font-size: 0.98rem; letter-spacing: -0.01em; }
  .token[data-k="value"] .tk-text { color: #6fd0ac; }

  /* ---- score charge ---- */
  .charge { display: flex; align-items: center; gap: 0.75rem; margin-top: 0.75rem; }
  .ch-num { font-family: var(--font-display); font-weight: 600; font-size: 1.35rem; font-variant-numeric: tabular-nums; }
  .ch-num i { font-style: normal; font-size: 0.75rem; color: var(--text-muted); font-weight: 400; }
  .ch-bar { display: inline-flex; gap: 4px; }
  .seg { width: 16px; height: 8px; border-radius: 2px; background: var(--border); }
  .seg.base { background: var(--border-strong); }
  .seg.earned { background: #54c9a2; }
  .ch-cap { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.06em; color: var(--text-muted); text-transform: uppercase; }

  /* ---- CTA (present + clickable from 0ms; motion only fades it in) ---- */
  .cta {
    margin-top: 1.75rem; display: inline-flex; align-items: center; gap: 0.4rem;
    background: var(--ink); color: var(--bg); font-weight: 500; letter-spacing: -0.01em;
    padding: 0.72rem 1.4rem; border-radius: var(--radius); font-size: 1.02rem;
    transition: opacity .3s var(--ease-out), transform .3s var(--ease-out);
  }
  .cta:hover { transform: translateY(-1px); }
  .cta-note { color: var(--text-muted); font-size: var(--step--1); margin-top: 0.6rem; }

  /* ================= motion signature (enhancement) =================
     Title → mark → tokens (stagger from centre) → score → CTA. Content is
     visible by default; JS adds .is-anim ONLY when motion is allowed, so no-JS
     and reduced-motion always see the finished, static composition. */
  .lab.is-anim .title { opacity: 0; translate: 0 12px; }
  .lab.is-anim .tagline { opacity: 0; }
  .lab.is-anim .mark { opacity: 0; scale: 0.9; }
  .lab.is-anim .token { opacity: 0; }
  .lab.is-anim .charge { opacity: 0; }
  .lab.is-anim .cta, .lab.is-anim .cta-note { opacity: 0; }

  .lab.play .title { animation: rise .6s var(--ease-out) both; }
  .lab.play .tagline { animation: fade .6s var(--ease-out) .12s both; }
  .lab.play .mark { animation: pop .55s var(--ease-out) .18s both; }
  .lab.play .token { animation: emanate .6s var(--ease-out) both; animation-delay: calc(.34s + var(--i) * .07s); }
  .lab.play .charge { animation: fade .5s var(--ease-out) .75s both; }
  .lab.play .cta { animation: fade .5s var(--ease-out) .86s both; }
  .lab.play .cta-note { animation: fade .5s var(--ease-out) .95s both; }

  @keyframes rise { from { opacity: 0; translate: 0 12px; } to { opacity: 1; translate: 0 0; } }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes pop { from { opacity: 0; scale: 0.9; } to { opacity: 1; scale: 1; } }
  /* tokens start pulled toward the centre and settle out to their orbit slot */
  @keyframes emanate {
    from { opacity: 0; transform: translate(-50%, -50%) translate(var(--dx, 0), var(--dy, 0)) scale(0.85); }
    to   { opacity: 1; transform: translate(-50%, -50%) translate(0, 0) scale(1); }
  }

  /* static everywhere motion isn't wanted */
  @media (prefers-reduced-motion: reduce) {
    .lab.is-anim .title, .lab.is-anim .tagline, .lab.is-anim .mark,
    .lab.is-anim .token, .lab.is-anim .charge, .lab.is-anim .cta, .lab.is-anim .cta-note { opacity: 1; translate: none; scale: none; }
  }

  /* mobile: calm static composition, no parallax, tighter orbit type */
  @media (max-width: 720px) {
    .tk-text { font-size: 0.9rem; }
    .token { padding: 0.4rem 0.6rem; }
    .mark-frame { width: 76px; height: 76px; }
    .mark-logo { width: 34px; height: 34px; }
  }
</style>

<script>
  // Progressive enhancement: stagger-in on load + cursor parallax on the tokens.
  // Static + accessible without this. Guardrail: the CTA is a real element that
  // is clickable immediately; motion only affects opacity/transform.
  function fine() {
    return matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches && innerWidth > 720;
  }

  function setupOrbit() {
    const lab = document.querySelector<HTMLElement>('.lab[data-orbit]');
    const stage = document.getElementById('stage');
    if (!lab || !stage || lab.dataset.bound) return;
    lab.dataset.bound = '1';

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const tokens = [...stage.querySelectorAll<HTMLElement>('.token')];
    const wires = [...stage.querySelectorAll<SVGLineElement>('.wire')];
    const mark = document.getElementById('mark');

    // seed each token's emanate origin (vector from its slot back to centre)
    const stageRect = () => stage.getBoundingClientRect();
    const seed = () => {
      const r = stageRect();
      const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
      tokens.forEach((t) => {
        const tr = t.getBoundingClientRect();
        const tx = tr.left + tr.width / 2, ty = tr.top + tr.height / 2;
        t.style.setProperty('--dx', `${(cx - tx) * 0.6}px`);
        t.style.setProperty('--dy', `${(cy - ty) * 0.6}px`);
      });
    };

    // play the entrance (skip the transform seeding under reduced-motion)
    if (!reduce) { seed(); lab.classList.add('is-anim'); requestAnimationFrame(() => requestAnimationFrame(() => lab.classList.add('play'))); }

    // wire highlight on token hover/focus
    const linkHot = (k: string | null) => wires.forEach((w) => w.toggleAttribute('data-hot', !!k && w.dataset.k === k));
    tokens.forEach((t) => {
      const on = () => { linkHot(t.dataset.k || null); stage.classList.add('is-hot'); };
      const off = () => { linkHot(null); stage.classList.remove('is-hot'); };
      t.addEventListener('pointerenter', on); t.addEventListener('focus', on);
      t.addEventListener('pointerleave', off); t.addEventListener('blur', off);
    });

    // cursor parallax — depth-weighted, lerped; desktop + motion only
    if (fine()) {
      let tx = 0, ty = 0, cx2 = 0, cy2 = 0, raf = 0;
      const onMove = (e: PointerEvent) => {
        const r = stageRect();
        tx = (e.clientX - (r.left + r.width / 2)) / (r.width / 2);
        ty = (e.clientY - (r.top + r.height / 2)) / (r.height / 2);
        if (!raf) raf = requestAnimationFrame(tick);
      };
      const tick = () => {
        cx2 += (tx - cx2) * 0.08; cy2 += (ty - cy2) * 0.08;
        tokens.forEach((t) => {
          const d = parseFloat(t.dataset.depth || '0.6');
          const px = -cx2 * 6 * d, py = -cy2 * 6 * d;
          t.style.transform = `translate(-50%, -50%) translate(${px}px, ${py}px)`;
        });
        if (mark) mark.style.transform = `translate(-50%, -50%) translate(${cx2 * 3}px, ${cy2 * 3}px)`;
        raf = Math.abs(tx - cx2) > 0.001 || Math.abs(ty - cy2) > 0.001 ? requestAnimationFrame(tick) : 0;
      };
      stage.addEventListener('pointermove', onMove);
      stage.addEventListener('pointerleave', () => { tx = 0; ty = 0; if (!raf) raf = requestAnimationFrame(tick); });
    }

    // token click → would scroll to the matching section on the real page
    tokens.forEach((t) => t.addEventListener('click', () => {
      t.animate([{ transform: 'translate(-50%,-50%) scale(1.08)' }, { transform: 'translate(-50%,-50%) scale(1)' }], { duration: 260, easing: 'cubic-bezier(0.16,1,0.3,1)' });
    }));
  }

  document.addEventListener('astro:page-load', setupOrbit);
  setupOrbit();
</script>
