---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/inter';
import '../../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
import Cursor from '../components/Cursor.astro';
import { site } from '@core/config/site';

interface Props {
  title?: string;
  description?: string;
  /** Path-relative or absolute OG image. */
  image?: string;
  /** Structured data object rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /**
   * Render the site header and footer. Off for standalone screens that carry
   * their own way out (the 404). Anything that turns this off is responsible
   * for its own navigation — without it the page is a dead end.
   */
  chrome?: boolean;
}

const {
  title,
  description = site.description,
  image = '/og-default.png',
  jsonLd,
  noindex = false,
  chrome = true,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
// Astro.site comes from astro.config, which resolves to the Vercel host in
// production. The fallback only matters in dev — never a domain we do not own.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImage = new URL(image, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b0a09" />

    <!-- Seamless client-side page transitions (Barba-equivalent) -->
    <ClientRouter />


    <!-- enable motion before first paint so reveals start hidden (no flash) -->
    <script is:inline>
      try {
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          var de = document.documentElement;
          de.classList.add('js-motion');
          // failsafe: if the motion bundle never boots, un-hide content so the page can't stay blank
          setTimeout(function () { if (!window.__motionReady) de.classList.remove('js-motion'); }, 2500);
        }
      } catch (e) {}
    </script>

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    {/* Consent Mode default, set BEFORE the ad tag loads.
        Previously there was no default at all: the tag went into <head>
        unconditionally and everything depended on whether the CMP happened to be
        switched on in the AdSense dashboard. Under ePrivacy/PECR a non-essential
        cookie may not be set before the user chooses — and cookie/tracker cases
        are the one category in which the Romanian authority has actually fined
        small site operators. Denying by default costs nothing here (no ad unit is
        configured, so nothing serves) and Google's certified CMP updates these
        signals to granted once the user accepts. */}
    {site.adsense.enabled && site.adsense.client && (
      <script is:inline set:html={`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          wait_for_update: 500
        });
      `}></script>
    )}
    {site.adsense.enabled && site.adsense.client && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsense.client}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body id="top" class:list={[{ 'no-chrome': !chrome }]}>
    {chrome && <a href="#main" class="sr-only skip-link">Skip to content</a>}
    {chrome && <Header />}
    <main id="main">
      <slot />
    </main>
    {chrome && <Footer />}
    <Cursor />
    <Motion />
  </body>
</html>
