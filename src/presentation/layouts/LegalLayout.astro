---
import Layout from './Layout.astro';
import MoneyNote from '@ui/components/MoneyNote.astro';

// Wraps a legal Markdown page in the public site chrome with a readable prose
// column. The `.md` pages under src/pages/legal/ point their `layout:`
// frontmatter here; Astro passes their frontmatter in and renders the body
// into <slot>. Kept deliberately plain — a policy page is for reading.
interface FrontMatter {
  title: string;
  /** Set on the disclosure policy: renders the live money position above the body. */
  money?: boolean;
  description?: string;
  /** Shown under the title; the body may also cite the effective date. */
  updated?: string;
  /** While true the page is noindex and shows a "draft, not in force" banner.
   *  Flip to false (and set the effective date) at publish time. */
  draft?: boolean;
}

const { frontmatter } = Astro.props as { frontmatter: FrontMatter };
const { title, description, updated, draft = true, money = false } = frontmatter;
---

<Layout title={title} description={description} noindex={draft}>
  <section class="legal">
    <div class="wrap">
      <div class="legal-inner">
        {draft && (
          <p class="legal-draft" role="note">
            <strong>Draft.</strong> This policy is being finalised and is not yet in force.
          </p>
        )}
        <header class="legal-head">
          <p class="legal-eyebrow">Legal</p>
          <h1>{title}</h1>
          {updated && <p class="legal-updated">Last updated: {updated}</p>}
        </header>
        {money && (
          <section class="legal-money" aria-label="What Studely earns today">
            <h2 class="legal-money-h">In one line</h2>
            <MoneyNote />
          </section>
        )}
        <article class="prose"><slot /></article>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Wide legal tables scroll horizontally; a scroll container must be reachable by
  // keyboard (WCAG 2.1.1 / axe scrollable-region-focusable). Only the ones that
  // actually overflow get a tab stop, and it's re-evaluated on resize.
  function tagScrollableTables() {
    document.querySelectorAll('.legal .prose table').forEach((t) => {
      if (t.scrollWidth > t.clientWidth + 1) {
        t.setAttribute('tabindex', '0');
        t.setAttribute('role', 'region');
        t.setAttribute('aria-label', 'Table (scroll horizontally)');
      } else {
        t.removeAttribute('tabindex');
        t.removeAttribute('role');
        t.removeAttribute('aria-label');
      }
    });
  }
  document.addEventListener('astro:page-load', tagScrollableTables);
  window.addEventListener('resize', tagScrollableTables);
</script>

<style>
  .legal { padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem); }
  .legal-inner { max-width: 72ch; margin-inline: auto; }

  .legal-draft {
    margin-bottom: 2rem; padding: 0.7rem 1rem; border-radius: var(--radius);
    border: 1px solid var(--rule-strong); background: var(--bg);
    font-size: var(--step--1); color: var(--text-muted);
  }
  .legal-draft strong { color: var(--ink); }

  .legal-head { margin-bottom: 2.25rem; padding-bottom: 1.4rem; border-bottom: 1px solid var(--rule); }
  .legal-eyebrow {
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.8rem;
  }
  .legal-head h1 { font-size: clamp(1.9rem, 1.4rem + 2.2vw, 3rem); letter-spacing: -0.02em; line-height: 1.05; }
  .legal-money { margin-bottom: var(--space-m); padding-bottom: var(--space-s); border-bottom: 1px solid var(--rule); }
  .legal-money-h { font-family: var(--font-mono); font-size: var(--step--2); font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: var(--space-2xs); }
  .legal-updated { margin-top: 0.7rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted); }

  /* the global .prose class styles headings/lists/links but not tables */
  .legal :global(.prose table) {
    width: 100%; border-collapse: collapse; margin-block: 1.35rem;
    font-size: var(--step--1); display: block; overflow-x: auto;
  }
  .legal :global(.prose th), .legal :global(.prose td) {
    border: 1px solid var(--rule); padding: 0.55rem 0.7rem; text-align: left; vertical-align: top;
  }
  .legal :global(.prose th) { color: var(--ink); font-weight: 600; background: var(--bg); white-space: nowrap; }
  /* anchor targets (Section links) should clear the sticky header */
  .legal :global(.prose h2) { scroll-margin-top: calc(var(--nav-h) + 1rem); }
</style>
