---
// The footer (Visual Direction v3 §5): one line. Identity and the money
// sentence on the left, the utility links on the right. No navigation — the
// register above is the navigation; no category list — the chips carry it.
import { site } from '@core/config/site';

const year = new Date().getFullYear();
const links = [
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
  { label: 'How we score', href: '/methodology' },
  { label: 'Privacy', href: '/legal/privacy' },
  { label: 'Terms', href: '/legal/terms' },
  { label: 'Cookies', href: '/legal/cookies' },
  { label: 'Disclosure', href: '/legal/disclosure' },
];
---

<footer class="site-footer">
  <div class="wrap">
    <p class="disclosure">{site.affiliateDisclosure}</p>
    <div class="line">
      <p class="who">
        <span class="name">{site.name}</span>
        <span class="sep" aria-hidden="true">·</span>
        <span>{site.availability}</span>
        <span class="sep" aria-hidden="true">·</span>
        <span>© {year}</span>
      </p>
      <nav aria-label="Footer">
        <ul class="links">
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer { margin-top: var(--space-2xl); border-top: 1px solid var(--rule-strong); padding: var(--space-m) 0 var(--space-l); font-size: var(--step--1); color: var(--text-muted); }
  .disclosure { max-width: 72ch; margin: 0 0 var(--space-s); }
  .line { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-xs) var(--space-m); }
  .who { display: flex; flex-wrap: wrap; gap: 0.5em; margin: 0; }
  .name { color: var(--ink); font-weight: 500; }
  .sep { color: var(--rule-strong); }
  .links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25em var(--space-s); }
  .links a { color: var(--ink); border-bottom: 1px solid transparent; }
  .links a:hover, .links a:focus-visible { border-bottom-color: var(--ink); }
</style>
