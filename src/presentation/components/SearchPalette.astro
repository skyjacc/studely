---
// One search surface for the whole site, on the native <dialog>. The index is
// the prerendered catalogue (title · provider · category · slug), embedded once
// as JSON — no search backend. Results are grouped Offers / Categories; Enter
// on the field goes to /offers?q=, which is the existing, no-JS search. On
// /offers the page script listens for `studely:search` and filters in place.
import { getAllOffers } from '@domain/offers/offers-source';
import { categories } from '@domain/offers/categories';
import { isExpired } from '@domain/offers/offers';
import { formatScore } from '@domain/offers/score';

const offers = (await getAllOffers()).filter((o) => !isExpired(o));
const index = {
  offers: offers.map((o) => ({ s: o.slug, t: o.data.title, p: o.data.provider, c: o.data.category, sc: formatScore(o.data.score) })),
  categories: categories.map((c) => ({ s: c.slug, n: c.name })),
};
---

<dialog class="palette" id="search-palette" aria-labelledby="search-palette-title">
  <div class="panel">
    <form class="field" role="search" action="/offers" method="get">
      <label class="sr-only" for="palette-q" id="search-palette-title">Search offers</label>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input id="palette-q" type="search" name="q" placeholder="Search offers, providers, categories" autocomplete="off" aria-controls="palette-results" aria-expanded="true" />
      <button type="button" class="close" data-palette-close aria-label="Close search">Esc</button>
    </form>
    <div class="results" id="palette-results" role="listbox" aria-label="Results"></div>
    <div class="empty" id="palette-empty" hidden>
      <p class="ttl" data-empty-title>Nothing yet</p>
      <p class="why muted" data-empty-why>Try a provider, a tool, or a category.</p>
      <a class="btn btn-ghost btn-sm" href="/offers">Open the register</a>
    </div>
  </div>
</dialog>
<script type="application/json" id="search-index" set:html={JSON.stringify(index)} />

<script>
  type Index = { offers: { s: string; t: string; p: string; c: string; sc: string }[]; categories: { s: string; n: string }[] };

  function bind() {
    const dlg = document.getElementById('search-palette') as HTMLDialogElement | null;
    if (!dlg || dlg.dataset.bound) return;
    dlg.dataset.bound = '1';
    const index: Index = JSON.parse(document.getElementById('search-index')!.textContent || '{"offers":[],"categories":[]}');
    const input = dlg.querySelector<HTMLInputElement>('#palette-q')!;
    const list = dlg.querySelector<HTMLElement>('#palette-results')!;
    const empty = dlg.querySelector<HTMLElement>('#palette-empty')!;
    const form = dlg.querySelector<HTMLFormElement>('form')!;
    const catName = (slug: string) => index.categories.find((c) => c.s === slug)?.n ?? slug;
    let active = -1;

    const render = () => {
      const q = input.value.trim().toLowerCase();
      list.innerHTML = '';
      active = -1;
      if (!q) { empty.hidden = true; list.hidden = true; return; }
      const offers = index.offers.filter((o) => `${o.t} ${o.p} ${catName(o.c)}`.toLowerCase().includes(q)).slice(0, 8);
      const cats = index.categories.filter((c) => c.n.toLowerCase().includes(q)).slice(0, 4);
      if (!offers.length && !cats.length) { list.hidden = true; empty.hidden = false; empty.querySelector('[data-empty-title]')!.textContent = `Nothing for "${input.value.trim()}"`; return; }
      empty.hidden = true; list.hidden = false;
      const group = (label: string, items: { href: string; main: string; meta: string }[]) => {
        if (!items.length) return;
        const h = document.createElement('p'); h.className = 'grp'; h.textContent = label; list.appendChild(h);
        for (const it of items) {
          const a = document.createElement('a');
          a.href = it.href; a.className = 'hit'; a.setAttribute('role', 'option');
          a.innerHTML = `<span class="main"></span><span class="meta"></span>`;
          a.querySelector('.main')!.textContent = it.main; a.querySelector('.meta')!.textContent = it.meta;
          list.appendChild(a);
        }
      };
      group('Offers', offers.map((o) => ({ href: `/offers/${o.s}`, main: o.t, meta: `${o.p} · ${o.sc}` })));
      group('Categories', cats.map((c) => ({ href: `/offers?cat=${c.s}`, main: c.n, meta: 'Category' })));
    };

    const hits = () => [...list.querySelectorAll<HTMLAnchorElement>('.hit')];
    const setActive = (i: number) => {
      const h = hits(); if (!h.length) return;
      active = (i + h.length) % h.length;
      h.forEach((el, k) => el.classList.toggle('is-active', k === active));
      h[active].scrollIntoView({ block: 'nearest' });
    };

    input.addEventListener('input', render);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Enter' && active >= 0) { e.preventDefault(); hits()[active].click(); }
    });
    // On /offers, Enter filters in place instead of reloading the same page.
    form.addEventListener('submit', (e) => {
      if (location.pathname.replace(/\/$/, '') !== '/offers') return;
      e.preventDefault();
      document.dispatchEvent(new CustomEvent('studely:search', { detail: input.value }));
      dlg.close();
    });
    list.addEventListener('click', () => dlg.close());
    dlg.querySelector('[data-palette-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    let opener: HTMLElement | null = null;
    dlg.addEventListener('close', () => {
      document.dispatchEvent(new CustomEvent('studely:palette-closed'));
      if (opener && document.contains(opener)) opener.focus({ preventScroll: true });
      opener = null;
    });

    const open = (from: HTMLElement | null = null) => { if (dlg.open) return; opener = from; dlg.showModal(); input.select(); render(); };
    document.querySelectorAll<HTMLElement>('[data-palette-open]').forEach((el) => {
      if (el.dataset.bound) return; el.dataset.bound = '1';
      el.addEventListener('click', (e) => { e.preventDefault(); open(el); });
    });
    (window as any).__openPalette = open;
    if (!(window as any).__paletteKeys) {
      (window as any).__paletteKeys = true;
      document.addEventListener('keydown', (e) => {
        const t = e.target as HTMLElement | null;
        const typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
        if (((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') || (e.key === '/' && !typing)) {
          e.preventDefault();
          (window as any).__openPalette?.(document.activeElement as HTMLElement | null);
        }
      });
    }
  }
  document.addEventListener('astro:page-load', bind);
  bind();
</script>

<style>
  .palette {
    position: fixed; inset: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0; background: transparent; color: var(--ink);
  }
  .palette::backdrop { background: rgba(var(--ink-rgb), 0.65); backdrop-filter: blur(3px); }
  .panel {
    position: absolute; left: 50%; top: min(12vh, 96px); transform: translateX(-50%);
    width: min(92vw, 40rem); max-height: 76dvh; display: flex; flex-direction: column;
    background: var(--bg-alt); border: 1px solid var(--rule-strong); border-radius: var(--radius-lg); overflow: hidden;
  }
  .field { display: flex; align-items: center; gap: var(--space-2xs); padding: var(--space-xs) var(--space-s); border-bottom: 1px solid var(--rule); color: var(--text-muted); }
  .field input { flex: 1; min-width: 0; min-height: 44px; background: none; border: 0; outline: none; color: var(--ink); font: inherit; font-size: var(--step-0); }
  .field input::placeholder { color: var(--text-muted); }
  .close { flex: none; font: inherit; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.08em; padding: 0.3em 0.55em; border: 1px solid var(--rule-control); border-radius: 6px; background: transparent; color: var(--text-muted); cursor: pointer; }
  .close:hover { color: var(--ink); border-color: var(--ink); }
  .results { overflow: auto; padding: var(--space-2xs) var(--space-2xs) var(--space-xs); }
  .results[hidden] { display: none; }
  .grp { font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); padding: var(--space-2xs) var(--space-xs) var(--space-3xs); }
  .hit { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-xs); padding: 0.55rem var(--space-xs); border-radius: var(--radius); color: var(--ink); }
  .hit:hover, .hit.is-active { background: var(--surface-2); }
  .hit .main { font-weight: 500; }
  .hit .meta { font-size: var(--step--2); color: var(--text-muted); white-space: nowrap; }
  .empty { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3xs); padding: var(--space-s); }
  .empty[hidden] { display: none; }
  .ttl { font-family: var(--font-display); font-size: var(--step-0); }
  .why { font-size: var(--step--1); }
  .empty .btn { margin-top: var(--space-2xs); }
  @media (prefers-reduced-motion: no-preference) {
    .palette[open] .panel { animation: pal-in .22s var(--ease-intro) both; }
  }
  @keyframes pal-in { from { opacity: 0; transform: translate(-50%, -6px); } to { opacity: 1; transform: translate(-50%, 0); } }
</style>
