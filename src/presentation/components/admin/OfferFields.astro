---
// The offer editor's fields, rendered from the registry (offer-fields.ts).
// Nothing here names a column: FORM_LAYOUT decides the rows, each field decides
// its own control, and offer-fields.test.ts fails when a registry field is
// missing from the layout. The slug block is the one hand-written control: it
// is not a registry column (locked after creation).
import { FORM_LAYOUT, fieldByName, type OfferField } from '@domain/offers/offer-fields';
import { getCategory } from '@domain/offers/categories';

interface Props {
  v: Record<string, any>;
  errors: Record<string, string>;
  createMode: boolean;
}
const { v, errors, createMode } = Astro.props;
const val = (k: string) => (v[k] ?? '') as string;
const err = (k: string) => errors[k];
const optionLabel = (f: OfferField, o: string) => (f.name === 'category' ? (getCategory(o)?.name ?? o) : o);
const rows = FORM_LAYOUT.map((names) => names.map((n) => fieldByName.get(n)!));
---

<div class="fields">
  {createMode ? (
    <label class="f">
      <span class="lb">Slug <em>the URL — locked after creation</em></span>
      <input name="slug" value={val('slug')} placeholder="github-student-pack" autocomplete="off" />
      {err('slug') && <span class="er">{err('slug')}</span>}
    </label>
  ) : (
    <div class="f">
      <span class="lb">Slug <em>locked</em></span>
      <code class="ro">{val('slug')}</code>
    </div>
  )}

  {rows.map((fields) =>
    fields.every((f) => f.input === 'checkbox') ? (
      <div class="flags">
        {fields.map((f) => (
          <label class="ck"><input type="checkbox" name={f.name} checked={Boolean(v[f.name])} /> {f.label}</label>
        ))}
      </div>
    ) : (
      <div class={fields.length > 1 ? 'two' : 'one'}>
        {fields.map((f) => (
          <label class="f">
            <span class="lb">{f.label}{f.hint && <em>{f.hint}</em>}</span>
            {f.input === 'textarea' ? (
              <textarea name={f.name} rows="10">{val(f.name)}</textarea>
            ) : f.input === 'select' ? (
              <select name={f.name}>
                {f.name === 'category' && <option value="">—</option>}
                {f.options!.map((o) => (
                  <option value={o} selected={val(f.name) === o}>{optionLabel(f, o)}</option>
                ))}
              </select>
            ) : f.name === 'expires_at' ? (
              <div class="row-exp">
                <input type="date" name={f.name} value={val(f.name)} />
                <label class="ck"><input type="checkbox" name="ongoing" checked={!val(f.name)} /> ongoing</label>
              </div>
            ) : (
              <input
                name={f.name}
                value={val(f.name)}
                placeholder={f.placeholder}
                inputmode={f.input === 'number' ? 'numeric' : undefined}
                style={f.input === 'number' ? 'max-width:140px' : undefined}
              />
            )}
            {err(f.name) && <span class="er">{err(f.name)}</span>}
          </label>
        ))}
      </div>
    ),
  )}
</div>

<style>
  .fields { display: flex; flex-direction: column; gap: 1rem; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .f { display: flex; flex-direction: column; gap: 6px; }
  .lb { font-size: 12.5px; color: var(--ink); font-weight: 500; }
  .lb em { font-style: normal; color: var(--text-muted); font-weight: 400; margin-left: 6px; }
  input, select, textarea {
    font: inherit; font-size: 14px; color: var(--ink); background: var(--surface);
    border: 1px solid var(--border-strong); border-radius: 9px; padding: 9px 11px; width: 100%;
    transition: border-color .16s var(--ease-out);
  }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--ink); }
  textarea { resize: vertical; font-family: var(--font-mono); font-size: 13px; line-height: 1.5; }
  .ro { display: inline-block; font-family: var(--font-mono); font-size: 13px; color: var(--text-muted); background: var(--surface-2); border: 1px solid var(--border); border-radius: 8px; padding: 8px 11px; }
  .er { font-size: 12px; color: var(--state-bad-ink); }
  .row-exp { display: flex; align-items: center; gap: 12px; }
  .row-exp input[type="date"] { max-width: 180px; }
  .ck { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; color: var(--ink); cursor: pointer; }
  .ck input { width: auto; }
  .flags { display: flex; flex-wrap: wrap; gap: 18px; padding: 4px 0; }
  @media (max-width: 640px) { .two { grid-template-columns: 1fr; } }
</style>
