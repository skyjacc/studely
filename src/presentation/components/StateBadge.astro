---
// A trust or commercial state as text + optional date. Positive states are
// mono; only problem states carry a hue (decision 5), and even then the label
// carries the meaning — the colour never does on its own.
//
// The problem words come from the entry-row vocabulary, so the record cannot
// describe a checker state differently from the register.
import { formatTrustDate, type TrustState } from '@domain/verification/trust';
import { problemWords } from '@ui/entry-row';

interface Props {
  state: TrustState | 'verified' | 'checked' | 'sponsored' | 'partner';
  date?: Date | null;
}
const { state, date = null } = Astro.props;

const OTHER: Record<'verified' | 'checked' | 'sponsored' | 'partner', string> = {
  verified: 'Verified',
  checked: 'Last checked',
  sponsored: 'Sponsored',
  partner: 'Partner link',
};
// A problem's words wrap its date ("… checks (Sep 21, 2026)"); everything else
// separates it with the register's middle dot.
const isProblem = !(state in OTHER);
const problem = isProblem ? problemWords(state as TrustState, Boolean(date)) : null;
const lead = problem ? problem.lead : OTHER[state as keyof typeof OTHER];
const trail = problem ? problem.trail : '';
const tone = problem ? problem.tone : 'mono';
---

<span class={`state state-${state} tone-${tone}`}>
  <span class="lbl">{lead}</span>
  {date && !problem && <span class="sep" aria-hidden="true">·</span>}
  {date && <time datetime={date.toISOString()}>{formatTrustDate(date)}</time>}
  {trail && <span class="lbl">{trail}</span>}
</span>

<style>
  .state { display: inline-flex; align-items: baseline; gap: 0.4em; font-size: var(--step--2); line-height: 1.3; color: var(--ink); }
  .lbl { font-weight: 500; }
  .sep, time { color: var(--text-muted); }
  time { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  /* the words wrap the date, so they must not be pushed apart by the flex gap */
  .tone-warn, .tone-bad { gap: 0.25em; }
  .tone-warn .lbl, .tone-warn time { color: var(--state-warn-ink); }
  .tone-bad .lbl, .tone-bad time { color: var(--state-bad-ink); }
  /* sponsored keeps its existing inverted treatment: it is the one loud label */
  .state-sponsored { padding: 0.1em 0.5em; border-radius: var(--radius-pill); background: var(--spon-bg); color: var(--spon-ink); }
</style>
