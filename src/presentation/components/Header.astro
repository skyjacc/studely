---
// The masthead (Visual Direction v3 §5): wordmark · Search · About — three
// things, one state. Solid paper with a rule beneath; nothing scrolls behind it
// that needs the space, so no transparency and no hide-on-scroll. Search is a
// field-shaped trigger for the palette on desktop (a plain link to the register
// without JS) and a button on mobile. "How we score" is not masthead navigation;
// it lives on the record, on /methodology and in the footer.
import { site } from '@core/config/site';
import Wordmark from './Wordmark.astro';
import Sheet from './Sheet.astro';

const path = Astro.url.pathname;
const current = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
const mobileLinks = [
  { href: '/', label: 'Home' },
  { href: '/offers', label: 'Register' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="masthead">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <Wordmark class="brand-logo" />
    </a>

    <div class="tools">
      <a class="search" href="/offers" data-palette-open aria-label="Search offers (⌘K)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <span class="ph">Search offers</span>
        <kbd class="kbd" aria-hidden="true">⌘K</kbd>
      </a>
      <a href="/about" class="about" aria-current={current('/about') ? 'page' : undefined}>About</a>
      <button type="button" class="menu" data-sheet-open="nav" aria-controls="sheet-nav" aria-expanded="false" aria-label="Open menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>

<Sheet id="nav" title="Menu" side="right">
  <form class="sheet-search" role="search" action="/offers" method="get">
    <input type="search" name="q" placeholder="Search offers" aria-label="Search offers" autocomplete="off" />
    <button type="submit" class="btn btn-primary btn-sm">Search</button>
  </form>
  <nav aria-label="Menu">
    <ul class="sheet-nav">
      {mobileLinks.map((l) => (
        <li><a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
</Sheet>

<style>
  .masthead { position: sticky; top: 0; z-index: 50; background: var(--bg); border-bottom: 1px solid var(--rule-strong); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-m); min-height: var(--nav-h); }
  .brand { display: inline-flex; align-items: center; color: var(--ink); }
  .brand :global(.brand-logo) { height: 24px; }
  .tools { display: flex; align-items: center; gap: var(--space-xs); }

  /* the search: field-shaped, opens the palette; a link to the register without JS */
  .search {
    display: inline-flex; align-items: center; gap: 0.45rem; min-height: 36px; padding: 0 0.75rem;
    border: 1px solid var(--rule-control); border-radius: 2px; color: var(--text-muted);
    transition: border-color .15s var(--ease-out), color .15s var(--ease-out);
  }
  .search:hover, .search:focus-visible { border-color: var(--ink); color: var(--ink); }
  .search svg { flex: none; }
  .ph { font-size: var(--step--1); min-width: 7.5rem; }
  .kbd { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.04em; padding: 0.1em 0.4em; border: 1px solid var(--rule); border-radius: 2px; color: var(--text-muted); }

  .about { font-size: var(--step-0); font-weight: 500; color: var(--ink); padding: 0.4rem 0.2rem; border-bottom: 1px solid transparent; }
  .about:hover, .about:focus-visible { border-bottom-color: var(--ink); }
  .about[aria-current="page"] { color: var(--text-muted); }

  .menu { display: none; place-items: center; width: 44px; height: 44px; border-radius: 2px; background: transparent; border: 1px solid var(--rule-control); color: var(--ink); cursor: pointer; }
  .menu:hover { background: var(--surface-2); }

  @media (max-width: 780px) {
    .search .ph, .search .kbd { display: none; }
    .search { width: 44px; height: 44px; padding: 0; justify-content: center; }
    .about { display: none; }
    .menu { display: grid; }
  }
  @media (prefers-reduced-motion: reduce) { .search, .about { transition: none; } }

  /* sheet contents */
  .sheet-search { display: flex; gap: var(--space-2xs); }
  .sheet-search input { flex: 1; min-width: 0; padding: 0.6rem 0.8rem; font: inherit; color: var(--ink); background: var(--bg); border: 1px solid var(--rule-control); border-radius: 2px; }
  .sheet-search input:focus { outline: none; border-color: var(--ink); }
  .sheet-nav { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; }
  .sheet-nav a { display: flex; align-items: center; min-height: 48px; font-family: var(--font-display); font-size: var(--step-1); letter-spacing: -0.02em; color: var(--ink); border-bottom: 1px solid var(--rule); }
  .sheet-nav a[aria-current="page"] { color: var(--text-muted); }
  .sheet-nav a[aria-current="page"]::after { content: 'Current'; margin-left: auto; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; }
</style>
