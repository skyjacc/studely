---
// The public header. Three states, driven by data attributes on the element
// and one small script (Visual Direction v2 §09):
//   data-state="hero"     transparent, only on a page with a hero (the home)
//   data-state="scrolled" solid + backdrop after a viewport of scroll
//   data-hidden           mobile: hides on scroll-down, returns on scroll-up;
//                         never while a sheet is open or the header has focus
// Internal pages start in the readable state — there is no hero behind them.
// One search (deep-links to /offers?q= with no JS), one contextual CTA, no
// sound toggle. The mobile menu is a Sheet on the native <dialog>.
import { site } from '@core/config/site';
import Wordmark from './Wordmark.astro';
import Sheet from './Sheet.astro';

interface Props {
  /** The page carries a hero the header may sit over transparently. */
  hero?: boolean;
}
const { hero = false } = Astro.props;

const path = Astro.url.pathname;
const links = [
  { href: '/offers', label: 'Offers' },
  { href: '/categories', label: 'Categories' },
  { href: '/about', label: 'About' },
];
const mobileLinks = [
  { href: '/', label: 'Home' },
  { href: '/offers', label: 'Offers' },
  { href: '/categories', label: 'Categories' },
  { href: '/methodology', label: 'How we score' },
  { href: '/about', label: 'About' },
];
const current = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
// No catalogue CTA on the catalogue (decision 9).
const showCta = !path.startsWith('/offers');
---

<header class="site-header" data-state={hero ? 'hero' : 'scrolled'} data-hero-page={hero ? '1' : undefined}>
  <div class="wrap bar">
    <div class="nav-left">
      <span class="nav-mask">
        <a href="/" class="brand" data-nav-item aria-label={`${site.name} home`}>
          <Wordmark class="brand-logo" />
        </a>
      </span>

      <nav class="nav" aria-label="Primary">
        {links.map((l) => (
          <span class="nav-mask">
            <a href={l.href} class="nav-roll" data-nav-item aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a>
          </span>
        ))}
      </nav>
    </div>

    <div class="actions">
      {/* Looks like a field, opens the palette. With JS off it is a plain link to
          the directory, whose own search still works. */}
      <a class="nav-search" href="/offers" data-palette-open aria-label="Search offers (⌘K)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <span class="ph">Search offers</span>
        <kbd class="kbd" aria-hidden="true">⌘K</kbd>
      </a>

      {showCta && (
        <span class="nav-mask">
          <a href="/offers" class="cta-btn" data-nav-item>
            <span class="cta-text-clip"><span class="cta-text">Browse offers</span></span>
            <span class="cta-arrow" aria-hidden="true">
              <span class="cta-arrow-bg"></span>
              <svg class="cta-arrow-svg" viewBox="0 0 12 12" fill="currentColor"><path d="M8.90954 9.09046L9 3L2.90954 3.09046L2.90213 4.32367L6.86437 4.25391L2.55914 8.55914L3.44086 9.44086L7.74609 5.13563L7.68708 9.10862L8.90954 9.09046Z"/></svg>
              <svg class="cta-arrow-svg is-dup" viewBox="0 0 12 12" fill="currentColor"><path d="M8.90954 9.09046L9 3L2.90954 3.09046L2.90213 4.32367L6.86437 4.25391L2.55914 8.55914L3.44086 9.44086L7.74609 5.13563L7.68708 9.10862L8.90954 9.09046Z"/></svg>
            </span>
          </a>
        </span>
      )}

      <button type="button" class="menu-btn" data-sheet-open="nav" aria-controls="sheet-nav" aria-expanded="false" aria-label="Open menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>

<Sheet id="nav" title="Menu" side="right">
  <form class="sheet-search" role="search" action="/offers" method="get">
    <input type="search" name="q" placeholder="Search offers" aria-label="Search offers" autocomplete="off" />
    <button type="submit" class="btn btn-primary btn-sm">Search</button>
  </form>
  <nav aria-label="Menu">
    <ul class="sheet-nav">
      {mobileLinks.map((l) => (
        <li><a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
</Sheet>

<script>
  // State machine: hero → scrolled after one viewport; mobile hide-on-down /
  // show-on-up past a small threshold. Focus inside the header and an open
  // sheet both force it visible.
  function bind() {
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!header || header.dataset.bound) return;
    header.dataset.bound = '1';
    const heroPage = header.dataset.heroPage === '1';
    const mobile = matchMedia('(max-width: 780px)');
    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      ticking = false;
      const y = window.scrollY;
      if (heroPage) header.dataset.state = y > window.innerHeight * 0.6 ? 'scrolled' : 'hero';
      if (mobile.matches && !document.documentElement.dataset.sheetOpen && !header.contains(document.activeElement)) {
        const down = y > lastY + 4 && y > 80;
        const up = y < lastY - 4;
        if (down) header.dataset.hidden = '1';
        else if (up || y <= 80) delete header.dataset.hidden;
      } else {
        delete header.dataset.hidden;
      }
      lastY = y;
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    header.addEventListener('focusin', () => delete header.dataset.hidden);
    update();
  }
  document.addEventListener('astro:page-load', bind);
  bind();
</script>

<style>
  .site-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    background: transparent; border-bottom: 1px solid transparent;
    transition: background-color .3s var(--ease-out), border-color .3s var(--ease-out), transform .35s var(--ease-out);
  }
  /* readable surface once there is content behind the bar */
  .site-header[data-state="scrolled"] {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    border-bottom-color: var(--border-soft);
  }
  .site-header[data-hidden] { transform: translateY(-100%); }
  @media (prefers-reduced-motion: reduce) { .site-header { transition: none; } }

  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-m); min-height: var(--nav-h); }
  .nav-left { display: flex; align-items: center; gap: clamp(1.4rem, 0.6rem + 3vw, 3rem); }
  .actions { display: flex; align-items: center; gap: var(--space-2xs); }

  .brand { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--ink); }
  .brand :global(.brand-logo) { height: 26px; }
  .nav-left > .nav-mask { line-height: 0; padding-block: 0; }

  .nav { display: flex; align-items: center; gap: 0.15rem; }
  .nav-mask { display: inline-block; overflow: hidden; vertical-align: middle; padding-block: 0.14em; }
  .nav-roll {
    position: relative; display: block; padding: 0.42rem 0.7rem; border-radius: 0.3rem;
    color: var(--ink); font-size: 1.02rem; font-weight: 500; letter-spacing: -0.01em;
  }
  .nav-roll::before {
    content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit;
    background: #393632;
    transform: scaleX(0); transform-origin: right center;
    transition: transform 0.55s cubic-bezier(0.2, 1, 0.36, 1);
  }
  .nav-roll:hover::before { transform: scaleX(1); transform-origin: left center; }
  .nav-roll[aria-current="page"] { color: var(--text-muted); }

  /* one search — deep-links to /offers?q= with no JS */
  .nav-search {
    display: flex; align-items: center; gap: 0.4rem; padding: 0.34rem 0.7rem;
    border: 1px solid var(--border-control); border-radius: var(--radius-pill);
    color: var(--text-muted); transition: border-color .2s var(--ease-out), color .2s var(--ease-out);
  }
  /* over the hero the bar is transparent and the field must still read as a
     field: give it a faint surface until the header turns solid */
  .site-header[data-state="hero"] .nav-search { background: rgba(8, 8, 7, 0.45); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .nav-search:hover, .nav-search:focus-visible { border-color: var(--ink); color: var(--ink); }
  .nav-search svg { flex: none; }
  .nav-search .ph { font-size: var(--step--1); min-width: 7.5rem; }
  .kbd { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.04em; padding: 0.1em 0.4em; border: 1px solid var(--border); border-radius: 5px; color: var(--text-muted); }

  /* CTA — rounded rect, marquee text + arrow aside-box (kept) */
  .cta-btn {
    display: inline-flex; align-items: stretch; gap: 0.5em;
    background: var(--ink); color: var(--bg);
    --btn-r: 0.55rem; --btn-pad: 0.25rem;
    border-radius: var(--btn-r); padding: var(--btn-pad) var(--btn-pad) var(--btn-pad) 0.95em;
    font-weight: 500; font-size: 1.0rem; letter-spacing: -0.01em;
  }
  .cta-text-clip { display: grid; align-self: center; overflow: clip; line-height: 1.2; }
  .cta-text { grid-area: 1 / 1; line-height: 1.2; text-shadow: 0 1.2em 0 currentColor; transition: transform 0.6s cubic-bezier(0.16, 1, 0.35, 1); }
  .cta-btn:hover .cta-text { transform: translateY(-1.2em); }
  .cta-arrow { position: relative; display: grid; place-items: center; flex: none; width: 1.7em; align-self: stretch; border-radius: calc(var(--btn-r) - var(--btn-pad)); overflow: hidden; }
  .cta-arrow-bg { position: absolute; inset: 0; background: rgba(8, 8, 7, 0.22); border-radius: inherit; transition: transform 0.65s cubic-bezier(0.16, 1, 0.35, 1); }
  .cta-btn:hover .cta-arrow-bg { transform: scale(0.82); }
  .cta-arrow-svg { grid-area: 1 / 1; position: relative; z-index: 1; width: 0.85em; height: 0.85em; transition: transform 0.5s cubic-bezier(0.16, 1, 0.35, 1); }
  .cta-arrow-svg.is-dup { transform: translate(-125%, 125%); }
  .cta-btn:hover .cta-arrow-svg:not(.is-dup) { transform: translate(125%, -125%); }
  .cta-btn:hover .cta-arrow-svg.is-dup { transform: translate(0, 0); }
  @media (prefers-reduced-motion: reduce) {
    .cta-text, .cta-arrow-bg, .cta-arrow-svg, .nav-roll::before { transition: none; }
  }

  /* menu button: mobile only, a real 44px target */
  .menu-btn {
    display: none; place-items: center; width: 44px; height: 44px; border-radius: var(--radius);
    background: transparent; border: 1px solid var(--border-control); color: var(--ink); cursor: pointer;
  }
  .menu-btn:hover { background: var(--surface-2); }

  @media (max-width: 960px) { .nav-search { display: none; } }
  @media (max-width: 780px) {
    .nav { display: none; }
    .cta-btn .cta-text-clip { display: none; }
    .cta-btn { padding: 0.25em; }
    .menu-btn { display: grid; }
  }

  /* sheet contents (scoped here: the Sheet only owns the frame) */
  .sheet-search { display: flex; gap: var(--space-2xs); }
  .sheet-search input {
    flex: 1; min-width: 0; padding: 0.6rem 0.8rem; font: inherit; color: var(--ink); background: var(--surface);
    border: 1px solid var(--border-control); border-radius: var(--radius);
  }
  .sheet-search input:focus { outline: none; border-color: var(--ink); }
  .sheet-nav { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; }
  .sheet-nav a {
    display: flex; align-items: center; min-height: 48px; padding: 0 var(--space-3xs);
    font-family: var(--font-display); font-size: var(--step-1); letter-spacing: -0.02em; color: var(--ink);
    border-bottom: 1px solid var(--border-soft);
  }
  .sheet-nav a[aria-current="page"] { color: var(--text-muted); }
  .sheet-nav a[aria-current="page"]::after { content: 'Current'; margin-left: auto; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; }
</style>
