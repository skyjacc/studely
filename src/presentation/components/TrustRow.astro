---
// What the record supports, in the fixed order Verified → Last checked → Proof →
// Who qualifies (the score sits in the identity row / block). Every line maps
// to data; with nothing backed the compact row renders nothing at all.
//   compact — the card: problem state or Verified, then Proof
//   full    — the detail page ledger: every backed row
//   table   — one cell: the state or Verified date, else the proof method
import type { OfferView } from '@domain/offers/offer-mapping';
import { deriveTrust } from '@domain/verification/trust';
import StateBadge from './StateBadge.astro';

interface Props {
  offer: OfferView;
  variant?: 'compact' | 'full' | 'table';
}
const { offer, variant = 'compact' } = Astro.props;
const t = deriveTrust(offer);
const problem = t.states[0] ?? null;
// One dated line on the card: the problem wins, else Verified, else nothing.
const headline = problem ? { state: problem, date: problem === 'stale' ? t.lastChecked : null }
  : t.verified ? { state: 'verified' as const, date: t.verified }
  : null;
---

{variant === 'compact' && (headline || t.proof) && (
  <div class="trust trust-compact">
    {headline && <StateBadge state={headline.state} date={headline.date} />}
    {t.proof && <span class="proof" title="Proof: how a student proves eligibility"><span class="k">Proof</span> {t.proof}</span>}
  </div>
)}

{variant === 'table' && (
  headline ? <StateBadge state={headline.state} date={headline.date} /> : <span class="proof-cell" title={t.proof}>{t.proof}</span>
)}

{variant === 'full' && (
  <dl class="trust trust-full">
    {problem && <div class="r"><dt>Status</dt><dd><StateBadge state={problem} date={problem === 'stale' ? t.lastChecked : null} /></dd></div>}
    {t.verified && <div class="r"><dt>Verified</dt><dd><StateBadge state="verified" date={t.verified} /></dd></div>}
    {t.lastChecked && !problem && <div class="r"><dt>Last checked</dt><dd><time datetime={t.lastChecked.toISOString()}>{t.lastChecked.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}</time></dd></div>}
    <div class:list={['r', { stack: t.proof.length > 20 }]}><dt>Proof</dt><dd>{t.proof}</dd></div>
    <div class:list={['r', { stack: t.whoQualifies.length > 20 }]}><dt>Who qualifies</dt><dd>{t.whoQualifies}</dd></div>
    {t.sponsored && <div class="r"><dt>Placement</dt><dd><StateBadge state="sponsored" /></dd></div>}
  </dl>
)}

<style>
  .trust-compact { display: flex; flex-direction: column; gap: var(--space-3xs); font-size: var(--step--2); line-height: 1.3; color: var(--text-muted); min-width: 0; }
  .proof { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .proof .k { color: var(--ink); font-weight: 500; margin-right: 0.35em; }
  .proof-cell { display: inline-block; max-width: 18ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: bottom; }

  .trust-full { display: flex; flex-direction: column; margin: 0; }
  .r { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: var(--space-xs); padding: var(--space-xs) 0; border-top: 1px solid var(--border); }
  .r:first-child { border-top: 0; }
  dt { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); align-self: baseline; }
  dd { margin: 0; color: var(--ink); text-align: right; overflow-wrap: anywhere; }
  time { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--step--1); }
  @media (max-width: 640px) {
    .r.stack { grid-template-columns: 1fr; gap: var(--space-3xs); }
    .r.stack dd { text-align: left; }
  }
</style>
