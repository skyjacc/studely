---
// The public motion layer, inside the budget (Visual Direction v2 §08): no
// smooth-scroll library, no animation library, no WebGL. Reveals are CSS
// transitions started by an IntersectionObserver; the hero and [data-enter]
// zones play on load with a DOM-order stagger; [data-split] words rise from a
// clip mask with a CSS animation. Content is visible without JS — global.css
// hides reveal targets only under html.js-motion — and prefers-reduced-motion
// bypasses everything here.
//
// What is NOT motion but lives here because it concerns the page lifecycle
// under the ClientRouter: a same-page link glides to the top instead of
// replaying the entrance, a forward navigation lands at the top, and a
// leftover body scroll lock never survives a swap.
---
<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // --- lifecycle -------------------------------------------------------------
  let navDirection = 'forward';
  document.addEventListener('astro:before-preparation', (e: any) => { navDirection = e.direction ?? 'forward'; });
  function resetScrollTop() {
    if (navDirection !== 'forward' || location.hash) return;
    window.scrollTo(0, 0);
  }
  document.addEventListener('click', (e: MouseEvent) => {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const a = (e.target as HTMLElement)?.closest?.('a') as HTMLAnchorElement | null;
    if (!a || a.target === '_blank' || a.hasAttribute('download') || !a.getAttribute('href')) return;
    let url: URL;
    try { url = new URL(a.href); } catch { return; }
    if (url.origin !== location.origin || url.hash) return;
    if (url.pathname !== location.pathname || url.search !== location.search) return;
    e.preventDefault();
    e.stopPropagation();
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
  }, { capture: true });

  // --- reveals ---------------------------------------------------------------
  let io: IntersectionObserver | null = null;

  function revealNow(el: Element) { el.classList.add('is-in'); }

  function setupPage() {
    if (reduce) return;
    io?.disconnect();
    io = new IntersectionObserver((entries) => {
      for (const en of entries) if (en.isIntersecting) { revealNow(en.target); io!.unobserve(en.target); }
    }, { rootMargin: '0px 0px -12% 0px' });

    // on-load zones: the home hero ([data-hero]) and the detail page's [data-enter]
    // elements play immediately, staggered by DOM order
    const onLoad = [...document.querySelectorAll<HTMLElement>('[data-hero] [data-reveal], [data-hero] [data-reveal-group], [data-enter]')];
    onLoad.forEach((el, i) => { el.style.setProperty('--i', String(i)); revealNow(el); });

    // everything else reveals on scroll, once
    for (const el of document.querySelectorAll('[data-reveal], [data-reveal-group]')) {
      if (el.classList.contains('is-in')) continue;
      io.observe(el);
    }

    // split text: words behind a clip mask, rising in sequence
    for (const el of document.querySelectorAll<HTMLElement>('[data-split]')) {
      if (!el.dataset.splitDone) {
        el.dataset.splitDone = '1';
        const words = (el.textContent || '').trim().split(/\s+/);
        el.textContent = '';
        words.forEach((w, i) => {
          const mask = document.createElement('span'); mask.className = 'split-mask';
          const word = document.createElement('span'); word.className = 'split-word'; word.textContent = w; word.style.setProperty('--i', String(i));
          mask.appendChild(word); el.appendChild(mask); el.appendChild(document.createTextNode(' '));
        });
      }
      if (el.closest('[data-hero]')) revealNow(el); else io.observe(el);
    }
  }

  document.addEventListener('astro:page-load', () => {
    try {
      resetScrollTop();
      setupPage();
      (window as any).__motionReady = true; // tells the head failsafe the layer booted
    } catch (e) {
      console.warn('motion failed to init', e);
      document.documentElement.classList.remove('js-motion');
    }
  });
  document.addEventListener('astro:before-swap', (e: any) => {
    io?.disconnect();
    if (!reduce && e.newDocument) e.newDocument.documentElement.classList.add('js-motion');
  });
  document.addEventListener('astro:after-swap', () => {
    document.body.style.overflow = '';
    resetScrollTop();
    requestAnimationFrame(resetScrollTop);
  });
</script>
