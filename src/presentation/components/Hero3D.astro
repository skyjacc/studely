---
// Hero WebGL — the shared two-pass dot-matrix field (src/presentation/visual/dot-field.ts),
// configured as drifting grey smoke with the halftone dots on top.
// Gated for perf/a11y; three.js is dynamically imported inside the module.
// Wired for Astro View Transitions (boot on astro:page-load, dispose on before-swap).
---
<div class="hero3d" aria-hidden="true">
  <canvas id="hero3d-canvas"></canvas>
</div>

<script>
  import { initDotField, dotFieldAllowed, type DotFieldConfig } from '@ui/visual/dot-field';

  // Their hero = smoke IMAGE + dot overlay. We have no image, so the shader carries
  // BOTH: a soft drifting grey CLOUD (the smooth field) + the halftone dots on top.
  const CFG: DotFieldConfig = {
    pixelSize: 4, gooeyness: 0.5, contrast: 1.0, bias: 0.0, invert: 0,
    amplitude: 1.3, timeSpeed: 0.3,
    bg: [0.031, 0.031, 0.027], fg: [0.56, 0.55, 0.51],
    cloud: [0.30, 0.29, 0.265], cloudStrength: 1.0,
    waveFrequency: 2.6, waveAmplitude: 0.08, waveTimeSpeed: 0.35,
    revealDuration: 2.0, maxDpr: 1.5,
  };

  let destroy: (() => void) | null = null;

  function boot() {
    const canvas = document.getElementById('hero3d-canvas') as HTMLCanvasElement | null;
    if (!canvas || destroy || !dotFieldAllowed()) return;
    const start = () =>
      initDotField(canvas, CFG)
        .then((d) => { destroy = d; })
        .catch((e) => console.warn('hero field skipped', e));
    if ('requestIdleCallback' in window) (window as any).requestIdleCallback(start, { timeout: 1400 });
    else setTimeout(start, 500);
  }

  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => { if (destroy) { destroy(); destroy = null; } });
</script>

<style>
  .hero3d { position: absolute; inset: 0; z-index: 0; overflow: hidden; background: #080807; }
  .hero3d::before {
    content: ''; position: absolute; inset: -10%;
    background:
      radial-gradient(60% 60% at 50% 45%, rgba(34, 32, 28, 0.85), transparent 70%), #080807;
    filter: blur(4px);
  }
  #hero3d-canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.1s ease; }
  #hero3d-canvas.is-live { opacity: 1; }
</style>
