---
// The Studely score, in one of three sizes. Text first: the number and the
// word carry the meaning; the tier only sets visual weight (never a hue).
//   inline — the card identity row: `8 / 10`, the word on hover / focus
//   block  — the detail page: number, word, and the caller's reasons below
//   row    — a table cell: `8 / 10`, nothing else
import { formatScore, scoreWord, scoreTier, describeScore } from '@domain/offers/score';

interface Props {
  score: number;
  variant?: 'inline' | 'block' | 'row';
  /** id of the visible "why this score" list, for aria-describedby on the block */
  describedBy?: string;
}
const { score, variant = 'inline', describedBy } = Astro.props;
const word = scoreWord(score);
const label = describeScore(score);
const tier = scoreTier(score);
---

{variant === 'block' ? (
  <p class={`score score-block tier-${tier}`} aria-label={label} aria-describedby={describedBy}>
    <span class="num" aria-hidden="true">{formatScore(score)}</span>
    <span class="word" aria-hidden="true">{word}</span>
  </p>
) : (
  <span class={`score score-${variant} tier-${tier}`} aria-label={label} title={variant === 'inline' ? word : undefined}>
    <span class="num" aria-hidden="true">{formatScore(score)}</span>
    {variant === 'inline' && <span class="word" aria-hidden="true">{word}</span>}
  </span>
)}

<style>
  .score { font-family: var(--font-display); font-variant-numeric: tabular-nums; letter-spacing: -0.02em; color: var(--ink); }
  .num { font-weight: 600; white-space: nowrap; }

  /* inline: the word rides beside the number, revealed on hover / focus-within of the card */
  .score-inline { display: inline-flex; align-items: baseline; gap: 0.45em; font-size: 1.05rem; line-height: 1; }
  .score-inline .word {
    font-family: var(--font-sans); font-size: var(--step--2); font-weight: 500; color: var(--text-muted);
    opacity: 0; transform: translateX(-4px); transition: opacity .2s var(--ease-out), transform .2s var(--ease-out);
  }
  :global(.offer:hover) .score-inline .word,
  :global(.offer:focus-within) .score-inline .word { opacity: 1; transform: none; }
  @media (hover: none) { .score-inline .word { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .score-inline .word { transition: none; } }

  /* row: number only, table weight */
  .score-row { font-size: 0.98rem; line-height: 1; }

  /* block: the detail page's trust statement */
  .score-block { display: flex; align-items: baseline; gap: var(--space-2xs); margin: 0; }
  .score-block .num { font-size: clamp(1.9rem, 1.5rem + 1.4vw, 2.6rem); line-height: 1; letter-spacing: -0.04em; }
  .score-block .word { font-family: var(--font-sans); font-size: var(--step-0); font-weight: 500; color: var(--text-muted); }

  /* tiers = weight, not colour */
  .tier-low .num { color: var(--text-muted); font-weight: 500; }
</style>
