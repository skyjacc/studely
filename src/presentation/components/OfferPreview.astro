---
// Offer Card v2 (Visual Direction v2 §06). Editorial hierarchy, not a row of
// badges: identity (provider · title · score) → value line with the type as a
// word → summary at a fixed rhythm → the trust row (only what a record backs)
// → one category chip and one real outbound link. Three separate targets —
// title (detail), category (filter), CTA (/go) — no stretched overlay.
import type { OfferView } from '@domain/offers/offer-mapping';
import { offerTypeLabel } from '@domain/offers/offers';
import { getCategory } from '@domain/offers/categories';
import Score from './Score.astro';
import TrustRow from './TrustRow.astro';
import OfferCTA from './OfferCTA.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props {
  offer: OfferView;
}
const { offer } = Astro.props;
const d = offer.data;
const cat = getCategory(d.category);
const href = `/offers/${offer.id}`;
// `$200k+ in tools · Free`, `50% off Premium · Discount` — the type is a word in
// the value line, no longer a chip (decision 7).
const typeWord = offerTypeLabel[d.offerType] ?? d.offerType;
---

<article class="offer" data-spotlight>
  <header class="identity">
    <span class="logo-tile" aria-hidden="true"><Logo provider={d.provider} /></span>
    <p class="provider">{d.provider}</p>
    <Score score={d.score} variant="inline" />
    <h3 class="title"><a href={href}>{d.title}</a></h3>
  </header>

  <p class="value"><span class="v">{d.value}</span><span class="sep" aria-hidden="true"> · </span><span class="t">{typeWord}</span></p>

  <p class="summary">{d.summary}</p>

  <TrustRow offer={offer} variant="compact" />

  <footer class="foot">
    <a class="chip" href={`/offers?cat=${d.category}`}><Icon category={d.category} /> {cat?.name ?? d.category}</a>
    <OfferCTA offer={offer} placement="card" />
  </footer>
</article>

<style>
  .offer {
    position: relative; isolation: isolate;
    /* rows: identity · value · summary · trust · footer — the footer pins to the
       bottom; nothing stretches text */
    display: grid; grid-template-rows: auto auto auto auto 1fr; gap: var(--space-2xs);
    padding: var(--space-s-m); height: 100%;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg);
    transition: border-color .25s var(--ease-out), background .25s var(--ease-out);
    min-width: 0;
  }
  .offer > * { min-width: 0; }
  .offer:hover, .offer:focus-within { border-color: var(--border-strong); }

  /* subtle spotlight (decision 8): two custom properties set on pointermove,
     fine pointers only, off under reduced motion; the pseudo-element is the
     whole effect — no JS is needed for the card to work */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .offer::before {
      content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; pointer-events: none;
      background: radial-gradient(220px circle at var(--sx, 50%) var(--sy, 50%), rgba(232, 232, 227, 0.06), transparent 60%);
      opacity: 0; transition: opacity .3s var(--ease-out);
    }
    .offer:hover::before { opacity: 1; }
  }

  /* identity: logo · provider · score on one row, the title full-width beneath —
     the score never squeezes the title into a narrow column */
  .identity {
    display: grid; grid-template-columns: 36px minmax(0, 1fr) auto; grid-template-areas: "logo provider score" "title title title";
    align-items: center; column-gap: var(--space-2xs); row-gap: var(--space-3xs);
  }
  .logo-tile { grid-area: logo; width: 36px; height: 36px; color: var(--ink); background: var(--surface-2); border-radius: 9px; }
  .provider { grid-area: provider; min-width: 0; font-size: var(--step--2); color: var(--text-muted); line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .identity :global(.score) { grid-area: score; }
  .title { grid-area: title; font-size: 1.08rem; line-height: 1.2; letter-spacing: -0.02em; margin-top: var(--space-3xs); text-wrap: balance; }
  .title a { color: var(--ink); transition: color .2s var(--ease-out); }
  .title a:hover { color: var(--accent-ink); }

  .value { font-family: var(--font-display); font-weight: 500; font-size: 1.02rem; letter-spacing: -0.01em; line-height: 1.3; }
  .value .sep, .value .t { color: var(--text-muted); font-weight: 400; }

  /* two lines at a fixed height: the rhythm comes from the box, not from
     stretching the text (the old flex: 1 + line-clamp leaked a third line) */
  .summary {
    font-size: var(--step--1); line-height: 1.4; color: var(--text-muted);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    height: calc(2 * 1.4em);
  }

  .foot { align-self: end; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2xs) var(--space-xs); padding-top: var(--space-2xs); border-top: 1px solid var(--border-soft); min-width: 0; }
  .chip { padding: 0.22em 0.6em; min-height: 32px; min-width: 0; max-width: 100%; }
  .chip :global(span), .chip { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .chip :global(.cat-ico) { width: 1em; height: 1em; color: var(--text-muted); }
  .chip:hover { border-color: var(--ink); }
</style>

<script>
  // Spotlight position only. Everything else on the card is CSS.
  const bind = () => {
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    for (const el of document.querySelectorAll<HTMLElement>('[data-spotlight]')) {
      if (el.dataset.bound) continue;
      el.dataset.bound = '1';
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--sx', `${e.clientX - r.left}px`);
        el.style.setProperty('--sy', `${e.clientY - r.top}px`);
      });
    }
  };
  document.addEventListener('astro:page-load', bind);
  bind();
</script>
