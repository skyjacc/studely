---
// "How every offer gets here" — a 4-step process line. Honest about sourcing
// (feeds, official programs, crawlers, reader tips) while the trust promise is
// the human-verify gate, not the source. Line draws on scroll; nodes fill on hover.
const steps = [
  {
    n: '01',
    t: 'Sourced everywhere',
    d: 'Partner feeds, official student programs, deal crawlers and reader tips — we cast wide.',
  },
  {
    n: '02',
    t: 'Human-verified',
    d: 'A person opens each one and confirms it is real and free for students before it goes live.',
  },
  {
    n: '03',
    t: 'Re-checked weekly',
    d: 'A scheduled job pings every link and flags dead or expired deals automatically.',
  },
  {
    n: '04',
    t: 'Eligibility, spelled out',
    d: 'We note exactly how to prove you are a student for each perk, so there are no surprises.',
  },
];
---

<div class="pipeline" data-reveal>
  <ol class="steps">
    {steps.map((s) => (
      <li class="step">
        <span class="node" aria-hidden="true"></span>
        <span class="step-n">{s.n}</span>
        <h3 class="step-t">{s.t}</h3>
        <p class="step-d">{s.d}</p>
      </li>
    ))}
  </ol>
</div>

<script>
  function setupPipeline() {
    document.querySelectorAll<HTMLElement>('.steps').forEach((el) => {
      if (el.dataset.io) return;
      el.dataset.io = '1';
      const io = new IntersectionObserver(
        (ents) => {
          ents.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.35 },
      );
      io.observe(el);
    });
  }
  document.addEventListener('astro:page-load', setupPipeline);
</script>

<style>
  .steps {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.5rem, 1rem + 2vw, 3.25rem);
    position: relative;
  }
  /* the connective hairline through the node row */
  .steps::before, .steps::after {
    content: ''; position: absolute; top: 5px; left: 0; right: 0; height: 1px;
  }
  .steps::before { background: var(--border-strong); }
  .steps::after {
    background: linear-gradient(90deg, var(--ink), color-mix(in srgb, var(--ink) 30%, transparent));
    transform: scaleX(0); transform-origin: left center;
    transition: transform 1.15s var(--ease-out);
  }
  .steps.is-in::after { transform: scaleX(1); }
  /* the scroll-triggered sweep and node fill bypass the global motion gate — mute
     them for users who ask for reduced motion (the line still appears, instantly) */
  @media (prefers-reduced-motion: reduce) {
    .steps::after { transition: none; }
    .node { transition: none; }
  }

  .step { position: relative; padding-top: 1.9rem; }
  .node {
    position: absolute; top: 0; left: 0; width: 11px; height: 11px; border-radius: 50%;
    background: var(--bg); border: 1px solid var(--border-strong); z-index: 1;
    transition: background .4s var(--ease-out), border-color .4s var(--ease-out), transform .4s var(--ease-out);
  }
  .step:hover .node { background: var(--ink); border-color: var(--ink); transform: scale(1.3); }

  .step-n { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.08em; }
  .step-t {
    margin-top: 0.5rem; font-family: var(--font-display); font-weight: 500;
    font-size: clamp(1.05rem, 0.85rem + 0.7vw, 1.4rem); letter-spacing: -0.025em; line-height: 1.1; color: var(--ink);
  }
  .step-d { margin-top: 0.5rem; color: var(--text-muted); font-size: var(--step--1); line-height: 1.5; max-width: 32ch; }

  @media (max-width: 820px) {
    .steps { grid-template-columns: 1fr 1fr; gap: 1.9rem 1.5rem; }
    .steps::before, .steps::after { display: none; }
    .step { padding-top: 0; padding-left: 1.1rem; border-left: 1px solid var(--border-strong); }
    .node { top: 0.35rem; left: -6px; }
    .step:hover .node { transform: scale(1); }
  }
  @media (max-width: 480px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
