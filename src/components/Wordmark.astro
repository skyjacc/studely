---
// Studely logotype. Traced from the brand artwork, then cleaned:
//  * the artwork's background rectangle is dropped, so the mark is transparent
//  * the counters of the d and e were separate shapes painted in the background
//    colour — merged into this path and rendered with fill-rule="evenodd", so
//    they are real holes and stay holes on any background
//  * fill="currentColor" so the mark follows the surrounding text colour
//  * viewBox cropped to the ink (the previous logo shipped with huge empty
//    margins and rendered almost invisibly small)
// Size it with `height` on the .wordmark class.
import { site } from '../data/site';

interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---

<svg
  class={`wordmark ${cls}`}
  viewBox="207 295 1368 340"
  fill="currentColor"
  fill-rule="evenodd"
  role="img"
  aria-label={site.name}
>
