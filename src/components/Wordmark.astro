---
// Studely wordmark.
//
// INTERIM: typographic, not a drawn logotype. The previous mark was a traced
// custom letterform spelling the old brand name; it could not be re-lettered
// into "Studely" without redrawing it. When a real logotype exists, put the SVG
// back here and keep the `.wordmark` class hook — call sites size this with
// `font-size`, so an SVG would need `height: 1em; width: auto` to match.
import { site } from '../data/site';

interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---

<span class={`wordmark ${cls}`} role="img" aria-label={site.name}>{site.name.toLowerCase()}</span>

<style>
  .wordmark {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 500;
    /* tight tracking so it reads as a mark rather than a run of body text */
    letter-spacing: -0.045em;
    line-height: 1;
    color: currentColor;
    white-space: nowrap;
    user-select: none;
  }
</style>
