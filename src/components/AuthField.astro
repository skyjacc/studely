---
// Sign-in backdrop: the same dot-matrix field as the hero (src/lib/dot-field.ts),
// tuned dark, slow and quiet so it reads as atmosphere behind the card rather than
// competing with it. Gated exactly like the hero — reduced-motion, touch and small
// screens get the plain background and never load three.js.
---
<div class="auth-field" aria-hidden="true">
  <canvas id="auth-field-canvas"></canvas>
</div>

<script>
  import { initDotField, dotFieldAllowed, type DotFieldConfig } from '../lib/dot-field';

  // Much calmer than the hero: half the drift speed, lower amplitude, dimmer dots.
  // A sign-in screen should feel still.
  const CFG: DotFieldConfig = {
    pixelSize: 5, gooeyness: 0.5, contrast: 1.0, bias: 0.0, invert: 0,
    amplitude: 0.9, timeSpeed: 0.14,
    bg: [0.031, 0.031, 0.027], fg: [0.26, 0.25, 0.23],
    cloud: [0.10, 0.098, 0.09], cloudStrength: 0.8,
    waveFrequency: 2.0, waveAmplitude: 0.05, waveTimeSpeed: 0.18,
    revealDuration: 1.8, maxDpr: 1.25,
  };

  // AdminLayout deliberately ships no ClientRouter, so astro:page-load never fires
  // here — this module script runs after parse, so boot straight away.
  const canvas = document.getElementById('auth-field-canvas') as HTMLCanvasElement | null;
  if (canvas && dotFieldAllowed()) {
    const start = () => initDotField(canvas, CFG).catch((e) => console.warn('auth field skipped', e));
    if ('requestIdleCallback' in window) (window as any).requestIdleCallback(start, { timeout: 1200 });
    else setTimeout(start, 400);
  }
</script>

<style>
  .auth-field { position: fixed; inset: 0; z-index: 0; overflow: hidden; background: #080807; }
  #auth-field-canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.2s ease; }
  #auth-field-canvas.is-live { opacity: 1; }
  /* keeps the centred card legible over whatever the field is doing underneath */
  .auth-field::after {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(52% 46% at 50% 50%, rgba(8, 8, 7, 0.88), rgba(8, 8, 7, 0.45) 60%, rgba(8, 8, 7, 0.2) 100%);
  }
</style>
