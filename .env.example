# Copy to .env and fill from your Supabase project (Settings → API).
# .env is gitignored — never commit real keys.

# Safe to expose to the browser. Row Level Security is what protects the data,
# not the secrecy of this key.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# BYPASSES Row Level Security. Server and build-time only — never import this
# into a component that ships to the browser, and never prefix it with PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Vercel Deploy Hook URL (Project → Settings → Git → Deploy Hooks).
# When set, publishing or editing a live offer in /admin triggers a rebuild so
# the static public site picks up the change. Unset = edits wait for the next deploy.
VERCEL_DEPLOY_HOOK_URL=

# Direct Postgres connection string (Supabase → Settings → Database). Used only
# by scripts/ops/backup-db.sh; not read by the app.
SUPABASE_DB_URL=

# Restore target for scripts/ops/restore-db.sh. Must be a disposable project or
# local Postgres — the script refuses the production project ref outright.
RESTORE_DB_URL=
# Production project ref the restore script must never write to. Override only
# if the production project itself changes.
PRODUCTION_DB_REF=myehxcjcdjxjysoeiynq

# Canonical production origin. Vercel also supplies
# VERCEL_PROJECT_PRODUCTION_URL, but this explicit value keeps server redirects,
# canonical URLs, sitemap and robots aligned.
PUBLIC_SITE_URL=https://studely.app
